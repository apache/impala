---- QUERY
# Delete-only MERGE: lineage is intentionally not generated (semantically
# equivalent to a DELETE), so an empty LINEAGE section asserts that no lineage
# record is emitted for this query.
merge into lineage_dml_test_db.iceberg_partitioned t
using functional_parquet.iceberg_partitioned s on t.id = s.id
when matched and s.action = "click" then delete
---- LINEAGE
====
