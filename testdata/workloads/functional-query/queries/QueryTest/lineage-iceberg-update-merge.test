---- QUERY
# MERGE whose UPDATE RHS mixes a target column and a source column.
# Only `c` is assigned, so `c` is the sole projection target — but its sources
# must include both target.a and source.b.
merge into lineage_dml_test_db.iceberg_wide t
using lineage_dml_test_db.iceberg_wide_src s on t.id = s.id
when matched then update set t.c = t.a + s.b
