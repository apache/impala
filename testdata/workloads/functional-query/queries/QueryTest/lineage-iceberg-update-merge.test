====
---- QUERY
drop database if exists lineage_dml_test_db cascade
====
---- QUERY
create database lineage_dml_test_db;
====
---- QUERY
create table lineage_dml_test_db.iceberg_non_partitioned
like functional_parquet.iceberg_non_partitioned;
alter table lineage_dml_test_db.iceberg_non_partitioned
set tblproperties ('format-version' = '$ICEBERG_FORMAT_VERSION')
====
---- QUERY
create table lineage_dml_test_db.iceberg_partitioned
like functional_parquet.iceberg_partitioned;
alter table lineage_dml_test_db.iceberg_partitioned
set tblproperties ('format-version' = '$ICEBERG_FORMAT_VERSION')
