---- QUERY
# Wide UPDATE FROM with 5 assigned columns in schema order. Uses the iceberg_wide
# / iceberg_wide_src pair set up earlier in the file. `c` is derived from a
# multi-source expression (s.a + s.b); the other four columns are direct copies
# from the source.
update t
set t.a = s.a,
    t.b = s.b,
    t.c = s.a + s.b,
    t.d = s.d,
    t.e = s.e
from lineage_dml_test_db.iceberg_wide t
join lineage_dml_test_db.iceberg_wide_src s on t.id = s.id
