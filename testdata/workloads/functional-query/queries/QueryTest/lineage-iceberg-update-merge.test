---- QUERY
# Same target columns as the previous UPDATE FROM, but assigned in reverse order.
# The generated lineage's projection edges must reference the same source columns
# for each target — assignment order in the SET clause is textual and must not
# affect the graph.
update t
set t.e = s.e,
    t.d = s.d,
    t.c = s.a + s.b,
    t.b = s.b,
    t.a = s.a
from lineage_dml_test_db.iceberg_wide t
join lineage_dml_test_db.iceberg_wide_src s on t.id = s.id
