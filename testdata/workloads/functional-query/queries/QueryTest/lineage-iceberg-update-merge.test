---- QUERY
# MERGE with two WHEN MATCHED UPDATE branches, columns assigned in different order,
# and a multi-source expression (c = a + b). Also touches d in the second branch
# only. `id` is never assigned; id must be included in the PREDICATE edge only.
merge into lineage_dml_test_db.iceberg_wide t
using lineage_dml_test_db.iceberg_wide_src s on t.id = s.id
when matched and s.a > 15
  then update set t.c = s.a + s.b, t.a = s.a, t.b = s.b
when matched
  then update set t.d = s.d, t.a = s.a, t.c = s.a + s.b
