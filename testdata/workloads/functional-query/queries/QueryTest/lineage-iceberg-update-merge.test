---- QUERY
# MERGE with an explicit self-assignment on the target column. Only the assigned
# column (event_time) should appear in the projection targets; the projection edge
# must still be produced so the self-dependency is visible in the lineage.
merge into lineage_dml_test_db.iceberg_partitioned t
using functional_parquet.iceberg_partitioned s on t.id = s.id
when matched then update set t.event_time = HOURS_ADD(t.event_time, 1)
