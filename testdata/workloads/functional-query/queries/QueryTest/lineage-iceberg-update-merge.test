---- QUERY
# MERGE with two WHEN NOT MATCHED INSERT branches using different column
# permutations. The union of assigned columns across the two branches should be
# {id, a, b, c, d} — column `e` is never assigned by any branch and must not
# appear as a projection target.
merge into lineage_dml_test_db.iceberg_wide t
using lineage_dml_test_db.iceberg_wide_src s on t.id = s.id
when not matched and s.a > 15
  then insert (id, a, b, c) values (s.id, s.a, s.b, s.a + s.b)
when not matched
  then insert (id, d, a) values (s.id, s.d, s.a)
