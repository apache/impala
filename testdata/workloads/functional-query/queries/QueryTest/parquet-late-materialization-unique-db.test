# This tests pages skipped by parquet late materialization.
====
---- QUERY
create table late_mat(i int, j int)
stored as parquet;
insert into late_mat values (1,1), (0,0), (1,1), (0,0), (0,0), (1,1);
set PARQUET_LATE_MATERIALIZATION_THRESHOLD=1;
select i, j from late_mat where j = 0;
---- RESULTS
0,0
0,0
0,0
---- TYPES
INT, INT
---- RUNTIME_PROFILE
aggregation(SUM, NumTopLevelValuesSkipped): 3
====
---- QUERY
# Test that when a column has more than one page, rows that are skipped up to a
# page boundary are discarded as whole pages (counted in
# NumPagesSkippedByLateMaterialization) without decompressing them, so no in-page
# top-level values need to be skipped (NumTopLevelValuesSkipped stays 0).
# Table `decimals_1_10` contains 60 rows, in which 8 rows are selected by the
# query and 52 rows are skipped.
set PARQUET_LATE_MATERIALIZATION_THRESHOLD=1;
set parquet_read_page_index = false;
select count(d_10) from decimals_1_10 where d_1 = 1;
---- RESULTS
8
---- RUNTIME_PROFILE
aggregation(SUM, NumPagesSkippedByLateMaterialization): 52
aggregation(SUM, NumTopLevelValuesSkipped): 0
====
---- QUERY
# Test the NumTopLevelValuesSkipped counter when the skipped rows end in the middle
# of a page, so the page must be decompressed and values skipped within it (rather
# than discarding whole pages). Column `d_1` has 5 values per page, so filtering on
# `d_10` (1 value per page) and reading `d_1` forces in-page value skipping.
# `d_10 = 3` selects the third value of each matching page, skipping the values
# before and after it inside the page.
# `d_10 = 3` matches 11 rows, 2 of which have a NULL `d_1`, so count(d_1) returns 9.
set PARQUET_LATE_MATERIALIZATION_THRESHOLD=1;
set parquet_read_page_index = false;
select count(d_1) from decimals_1_10 where d_10 = 3;
---- RESULTS
9
---- RUNTIME_PROFILE
aggregation(SUM, NumPagesSkippedByLateMaterialization): 1
aggregation(SUM, NumTopLevelValuesSkipped): 44
====
---- QUERY
# Test if PARQUET_LATE_MATERIALIZATION_THRESHOLD is always 1 if there is any
# collection that can be skipped.
set parquet_read_page_index = false;
select count(unnest(arr)) from nested_decimals n where d_38 = 1;
---- RESULTS
4
---- RUNTIME_PROFILE
aggregation(SUM, NumPagesSkippedByLateMaterialization): 0
aggregation(SUM, NumTopLevelValuesSkipped): 17
====
---- QUERY
# Selects the last row in a row group and then skips the first row in the next
# row group.
select count(o_orderkey)
from customer_nested_multiblock_multipage t
left join t.c_orders
where cast(c_custkey as string) like '100';
---- RESULTS
20
---- RUNTIME_PROFILE
aggregation(SUM, NumPagesSkippedByLateMaterialization): 0
aggregation(SUM, NumTopLevelValuesSkipped): 299
====
