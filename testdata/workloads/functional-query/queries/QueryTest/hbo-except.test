---- QUERY
# EXPLAIN the rewritten query which is equivalent to the EXCEPT query
EXPLAIN select * from (
  select distinct id from functional.alltypes
  where string_col != 'test_except'
) t1
where not exists (
  select 1 from functional.alltypestiny t2
  where string_col != 'test_except' and t1.id <=> t2.id)
