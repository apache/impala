---- QUERY
# TIMESTAMP stored as INT64.
set parquet_page_row_count_limit=2;
set parquet_timestamp_type=INT64_MICROS;
create table int64_timestamp (c timestamp) sort by (c) stored as parquet;
insert into int64_timestamp values (cast('2026-01-01' as timestamp)),
    (cast('2026-01-02' as timestamp)), (cast('2026-01-03' as timestamp)),
    (cast('2026-01-04' as timestamp)), (cast('2026-01-05' as timestamp)),
    (cast('2026-01-06' as timestamp)), (cast('2026-01-07' as timestamp)),
    (cast('2026-01-08' as timestamp)), (cast('2026-01-09' as timestamp)),
    (cast('2026-01-10' as timestamp));
select count(*) from int64_timestamp
---- RESULTS
10
---- TYPES
BIGINT
====
---- QUERY
# The queries below join with two literals and check how many pages the min/max
# filter skipped. The Python test sets the filtering options. The filter [-3,-2]
# keeps only the page [-3,-2].
select straight_join count(*) from int_to_bigint a
join (values (cast(-3 as bigint) v), (cast(-2 as bigint))) b on a.c = b.v
---- RESULTS
2
---- TYPES
BIGINT
---- RUNTIME_PROFILE
aggregation(SUM, NumRuntimeFilteredPages): 4
====
