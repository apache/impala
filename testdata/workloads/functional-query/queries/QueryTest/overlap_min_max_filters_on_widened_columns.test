---- QUERY
# DECIMAL(9,2) stored as INT32 read as DECIMAL(18,2), and DECIMAL(10,2) stored as INT64
# read as DECIMAL(20,2). The file has two row groups: [-5,-1] with pages [-5,-4],
# [-3,-2], [-1] and [0,4] with pages [0,1], [2,3], [4]. The filter [-1,0] overlaps both
# row groups and keeps the pages [-1] and [0,1].
select straight_join count(*) from int_decimal_wide a
join (values (cast(-1 as decimal(18,2)) v), (cast(0 as decimal(18,2)))) b on a.d32 = b.v
---- RESULTS
2
---- TYPES
BIGINT
---- RUNTIME_PROFILE
aggregation(SUM, NumRuntimeFilteredPages): 4
====
