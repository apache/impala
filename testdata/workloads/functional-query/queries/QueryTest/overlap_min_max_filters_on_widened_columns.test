====
---- QUERY
# IMPALA-15443: min/max filters on columns whose table type is wider than the type
# in the Parquet files, e.g. after ALTER TABLE CHANGE COLUMN or an Iceberg type
# promotion. Each of these tables is sorted by its only column and has one file with
# one row group and 5 pages: [-5,-4], [-3,-2], [-1,0], [1,2], [3,4].
set parquet_page_row_count_limit=2;
create table int_to_bigint (c int) sort by (c) stored as parquet;
insert into int_to_bigint
values (-5), (-4), (-3), (-2), (-1), (0), (1), (2), (3), (4);
alter table int_to_bigint change c c bigint;
select count(*) from int_to_bigint
---- RESULTS
10
---- TYPES
BIGINT
====
