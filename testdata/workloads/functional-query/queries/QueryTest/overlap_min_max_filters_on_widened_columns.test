---- QUERY
# Tables with a NULL page before the other pages, like in files sorted with NULLS FIRST,
# e.g. by Spark or Iceberg. The rows are inserted in this order, so the file has one row
# group and 6 pages: [NULL,NULL], [-5,-4], [-3,-2], [-1,0], [1,2], [3,4]. The page index
# is still ASCENDING, because NULL pages are ignored when it is computed. So the non-NULL
# pages are processed as a span that starts at the second page.
set parquet_page_row_count_limit=2;
create table int_nulls_first (c int) stored as parquet;
insert into int_nulls_first values (cast(NULL as int)), (NULL), (-5), (-4), (-3), (-2),
    (-1), (0), (1), (2), (3), (4);
select count(*), count(c) from int_nulls_first
---- RESULTS
12,10
---- TYPES
BIGINT,BIGINT
====
