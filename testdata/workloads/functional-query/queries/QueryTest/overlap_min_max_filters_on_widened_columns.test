---- QUERY
# The filter [3,4] keeps only the last page. The NULL page is skipped too, and
# NumStatsFilteredPages counts all pages that are skipped.
select straight_join count(*) from int_nulls_first a
join (values (cast(3 as int) v), (cast(4 as int))) b on a.c = b.v
---- RESULTS
2
---- TYPES
BIGINT
---- RUNTIME_PROFILE
aggregation(SUM, NumRuntimeFilteredPages): 5
aggregation(SUM, NumStatsFilteredPages): 5
