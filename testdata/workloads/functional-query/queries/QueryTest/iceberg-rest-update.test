====
---- QUERY
# Adapted from iceberg-v3-update.test for REST catalog.
# Tables are pre-created via the REST API; DDL tests (CREATE TABLE,
# ALTER TABLE, DELETE, CREATE VIEW, UDF) are omitted.
# TODO: Remove this file and run iceberg-v3-update.test against the REST catalog
# once CREATE TABLE, CTAS and ALTER TABLE are supported for REST catalog tables.
# Basic UPDATE on unpartitioned V3 table via REST catalog.
INSERT INTO update_basic VALUES (1, 'one'), (2, 'two'), (3, 'three');
UPDATE update_basic SET s = 'updated' WHERE i = 2;
---- RUNTIME_PROFILE
NumModifiedRows: 1
NumDeletedRows: 1
====
---- QUERY
SELECT * FROM update_basic ORDER BY i;
---- RESULTS
1,'one'
2,'updated'
3,'three'
---- TYPES
INT,STRING
====
---- QUERY
# _row_id is preserved, _last_updated_sequence_number is updated.
SELECT _row_id, _last_updated_sequence_number, '|', * FROM update_basic ORDER BY i;
---- RESULTS
0,1,'|',1,'one'
1,2,'|',2,'updated'
2,1,'|',3,'three'
---- TYPES
BIGINT,BIGINT,STRING,INT,STRING
====
---- QUERY
# The delete side of UPDATE creates a DV (Puffin) file.
SELECT content, file_format, record_count, referenced_data_file IS NOT NULL, content_offset IS NOT NULL
FROM $DATABASE.update_basic.`files`
ORDER BY content, file_format;
---- RESULTS
0,'PARQUET',1,false,false
0,'PARQUET',3,false,false
1,'PUFFIN',1,true,true
---- TYPES
INT,STRING,BIGINT,BOOLEAN,BOOLEAN
====
---- QUERY
# UPDATE multiple rows at once.
INSERT INTO update_multi VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'), (5, 'e');
UPDATE update_multi SET s = upper(s) WHERE i >= 3;
---- RUNTIME_PROFILE
NumModifiedRows: 3
NumDeletedRows: 3
====
---- QUERY
SELECT * FROM update_multi ORDER BY i;
---- RESULTS
1,'a'
2,'b'
3,'C'
4,'D'
5,'E'
---- TYPES
INT,STRING
====
---- QUERY
# _row_id is preserved, _last_updated_sequence_number is updated.
SELECT _row_id, _last_updated_sequence_number, '|', * FROM update_multi ORDER BY i;
---- RESULTS
0,1,'|',1,'a'
1,1,'|',2,'b'
2,2,'|',3,'C'
3,2,'|',4,'D'
4,2,'|',5,'E'
---- TYPES
BIGINT,BIGINT,STRING,INT,STRING
====
---- QUERY
