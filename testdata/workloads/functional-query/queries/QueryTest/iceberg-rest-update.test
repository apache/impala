====
---- QUERY
# Test if changing SKIP_UNNEEDED_UPDATES_COL_LIMIT query option takes effect: the row
# is updated even though the table content remained the same.
UPDATE update_basic SET i = cast(i * 10 as int), s = 'same';
---- RUNTIME_PROFILE
NumModifiedRows: 3
NumDeletedRows: 3
====
---- QUERY
SET SKIP_UNNEEDED_UPDATES_COL_LIMIT = 1;
UPDATE update_basic SET i = 10, s = 'same' WHERE i = 10;
---- DML_RESULTS: update_basic
10,'same'
20,'same'
30,'same'
---- TYPES
INT,STRING
---- RUNTIME_PROFILE
NumModifiedRows: 1
NumDeletedRows: 1
====
---- QUERY
# Setting SKIP_UNNEEDED_UPDATES_COL_LIMIT back to default. No rows should be updated.
SET SKIP_UNNEEDED_UPDATES_COL_LIMIT = 10;
UPDATE update_basic SET i = 10, s = 'same' WHERE i = 10;
---- DML_RESULTS: update_basic
10,'same'
20,'same'
30,'same'
---- TYPES
INT,STRING
---- RUNTIME_PROFILE
NumModifiedRows: 0
NumDeletedRows: 0
