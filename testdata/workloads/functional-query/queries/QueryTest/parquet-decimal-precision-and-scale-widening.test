---- QUERY
# IMPALA-15443: row group statistics and page index of DECIMAL columns stored as INT32
# and INT64, read into slots of the same and of wider types. The file has two row
# groups: [-5,-1] with pages [-5,-4], [-3,-2], [-1] and [0,4] with pages [0,1], [2,3],
# [4]. Only the predicate column is materialized, so the page counters count its pages.
select count(*) from int_decimal_stats_orig where d32 < 0
---- RESULTS
5
---- TYPES
BIGINT
---- RUNTIME_PROFILE
aggregation(SUM, NumStatsFilteredRowGroups): 1
aggregation(SUM, NumStatsFilteredPages): 0
