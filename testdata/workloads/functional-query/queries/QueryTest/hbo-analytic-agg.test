|  functions: rank()
|  order by: id ASC
|  window: RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
|  row-size=29B cardinality=620
|
04:MERGING-EXCHANGE [UNPARTITIONED]
|  order by: id ASC
|
01:SORT
|  order by: id ASC
|  row-size=21B cardinality=620
