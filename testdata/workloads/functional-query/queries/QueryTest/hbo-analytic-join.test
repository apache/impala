---- QUERY
# Changing the analytic functions, the JOIN node have no HBO stats
EXPLAIN select straight_join t1.int_col, t1.rnk from
  (select int_col, rank() over (order by bigint_col, id asc) as rnk
   from functional.alltypes
   where month=1 and string_col != 'test_join_over_analytic') t1,
  (select int_col, rank() over (order by bigint_col, id desc) as rnk
   from functional.alltypestiny
   where month=1 and string_col != 'test_join_over_analytic') t2
where t1.int_col = t2.int_col and t1.rnk = t2.rnk
