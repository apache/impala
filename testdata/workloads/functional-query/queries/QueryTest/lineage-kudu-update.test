====
---- QUERY
# Create a reference table for Kudu UPDATE FROM test
create table lineage_dml_test_db.kudu_ref_table
primary key (id)
partition by hash(id) partitions 3
stored as kudu
as select id, string_col as new_string, bigint_col as new_bigint
from functional_kudu.alltypessmall limit 5
====
