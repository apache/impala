---- QUERY
# Multi-column UPDATE that mixes literals with expressions referencing multiple
# source columns (bigint_col = int_col + tinyint_col). Verifies that the sources
# of a projection edge include every referenced column and that no self-assignment
# noise edges are produced for columns not in the SET list.
update lineage_dml_test_db.kudu_tbl
set string_col = "combo",
    bigint_col = int_col + tinyint_col,
    smallint_col = tinyint_col
where id = 0
---- LINEAGE
{
  "queryText": "update lineage_dml_test_db.kudu_tbl set string_col = \"combo\",     bigint_col = int_col + tinyint_col,     smallint_col = tinyint_col where id = 0",
