---- QUERY
# Same targets as above but assigned in a different, non-schema-order permutation.
# The lineage output should be identical modulo vertex id assignment order — every
# assigned column must appear as a projection target regardless of textual order.
update lineage_dml_test_db.kudu_tbl
set string_col = "reordered", bigint_col = 30, tinyint_col = 10, int_col = 20
where id = 0
