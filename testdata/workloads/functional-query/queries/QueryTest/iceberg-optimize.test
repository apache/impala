row_regex:'$NAMENODE/test-warehouse/$DATABASE.db/ice_optimize_partition/data/i=2/.*.0.parq','.*','','$ERASURECODE_POLICY'
row_regex:'$NAMENODE/test-warehouse/$DATABASE.db/ice_optimize_partition/data/i=2/.*.0.parq','.*','','$ERASURECODE_POLICY'
row_regex:'$NAMENODE/test-warehouse/$DATABASE.db/ice_optimize_partition/data/i=3/.*.0.parq','.*','','$ERASURECODE_POLICY'
