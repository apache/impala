---- QUERY
# OPTIMIZE with a PARTITION clause on a table that has position delete files: the
# deletes of the selected partition are merged into the data, the deletes of the other
# partitions are left untouched.
CREATE TABLE ice_optimize_partition_deletes (i int, s string)
PARTITIONED BY SPEC(i)
STORED BY ICEBERG
TBLPROPERTIES ('format-version'='2');
====
---- QUERY
# One data file and one position delete file per partition.
INSERT INTO ice_optimize_partition_deletes VALUES (1, 'a'), (1, 'b');
INSERT INTO ice_optimize_partition_deletes VALUES (2, 'c'), (2, 'd');
DELETE FROM ice_optimize_partition_deletes WHERE s = 'b';
DELETE FROM ice_optimize_partition_deletes WHERE s = 'd';
SELECT `partition`.i, content, count(*)
FROM $DATABASE.ice_optimize_partition_deletes.`files`
GROUP BY 1, 2;
---- RESULTS
1,0,1
1,1,1
2,0,1
2,1,1
---- TYPES
INT,INT,BIGINT
====
---- QUERY
# Partition i=1 has no data file that is free of deletes, but its single data file has
# deletes to merge, so the statement is not a no-op. Afterwards i=1 holds one data file
# and no delete file, while i=2 still has both of its files.
OPTIMIZE TABLE ice_optimize_partition_deletes PARTITION (i = 1);
SELECT `partition`.i, content, count(*)
FROM $DATABASE.ice_optimize_partition_deletes.`files`
GROUP BY 1, 2;
---- RESULTS
1,0,1
2,0,1
2,1,1
---- TYPES
INT,INT,BIGINT
====
---- QUERY
# The compacted data file was written to the partition it belongs to, and the delete
# file of partition i=1 is gone.
SHOW FILES IN ice_optimize_partition_deletes;
---- LABELS
Path,Size,Partition,EC Policy
