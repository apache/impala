row_regex:'$NAMENODE/test-warehouse/$DATABASE.db/ice_optimize_partition_threshold/data/i=1/.*.0.parq','.*','','$ERASURECODE_POLICY'
row_regex:'$NAMENODE/test-warehouse/$DATABASE.db/ice_optimize_partition_threshold/data/i=2/.*.0.parq','.*','','$ERASURECODE_POLICY'
