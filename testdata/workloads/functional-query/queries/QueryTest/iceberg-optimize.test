---- QUERY
# OPTIMIZE ... PARTITION is not restricted to identity specs. bucket(2, i) places i=1 and
# i=2 into bucket 0 and i=3 into bucket 1.
CREATE TABLE ice_optimize_part_bucket (i int, s string)
PARTITIONED BY SPEC (bucket(2, i))
STORED BY ICEBERG
TBLPROPERTIES ('format-version'='2');
INSERT INTO ice_optimize_part_bucket VALUES (1, 'a');
INSERT INTO ice_optimize_part_bucket VALUES (2, 'b');
INSERT INTO ice_optimize_part_bucket VALUES (3, 'c');
SELECT `partition`.i_bucket, count(*)
FROM $DATABASE.ice_optimize_part_bucket.`files` GROUP BY 1;
---- RESULTS
0,2
1,1
---- TYPES
INT,BIGINT
====
---- QUERY
# Only bucket 0 is compacted; bucket 1 keeps its own file.
OPTIMIZE TABLE ice_optimize_part_bucket PARTITION (bucket(2, i) = 0);
SELECT `partition`.i_bucket, count(*)
FROM $DATABASE.ice_optimize_part_bucket.`files` GROUP BY 1;
---- RESULTS
0,1
1,1
---- TYPES
INT,BIGINT
====
---- QUERY
SELECT * FROM ice_optimize_part_bucket;
---- RESULTS
1,'a'
2,'b'
3,'c'
---- TYPES
INT,STRING
====
---- QUERY
# A truncate spec: 'impala' and 'implicit' share the partition s_trunc=im, 'iceberg' is in
# s_trunc=ic.
CREATE TABLE ice_optimize_part_truncate (i int, s string)
PARTITIONED BY SPEC (truncate(2, s))
STORED BY ICEBERG
TBLPROPERTIES ('format-version'='2');
