select st_bin(1.0, st_point(-500, -1000))
---- TYPES
BIGINT
---- RESULTS
4611689052463623000
====
---- QUERY
select st_bin(1.0, "point(800 -5000)")
---- TYPES
BIGINT
---- RESULTS
4611701200465620300
====
---- QUERY
select st_bin(1, st_point(800, -5000))
---- TYPES
BIGINT
---- RESULTS
4611701200465620300
