---- QUERY
select st_astext(st_binenvelope(1, st_point(1, 2)));
---- TYPES
STRING
---- RESULTS
'POLYGON ((1 1, 2 1, 2 2, 1 2, 1 1))'
====
---- QUERY
select st_astext(st_binenvelope(1.0, st_point(1, 2)));
---- TYPES
STRING
---- RESULTS
'POLYGON ((1 1, 2 1, 2 2, 1 2, 1 1))'
====

---- QUERY
select st_astext(st_binenvelope(1, "point(1 2)"));
---- TYPES
STRING
---- RESULTS
'POLYGON ((1 1, 2 1, 2 2, 1 2, 1 1))'
====
---- QUERY
select st_astext(st_binenvelope(1.0, "point(1 2)"));
---- TYPES
STRING
---- RESULTS
'POLYGON ((1 1, 2 1, 2 2, 1 2, 1 1))'
====
---- QUERY
# ST_StartPoint / ST_EndPoint
select ST_AsText(ST_StartPoint(ST_LineString(1,2, 3,4, 5,6)));
---- TYPES
STRING
---- RESULTS
'POINT (1 2)'
====
---- QUERY
select ST_AsText(ST_EndPoint(ST_LineString(1,2, 3,4, 5,6)));
---- TYPES
STRING
---- RESULTS
'POINT (5 6)'
====
---- QUERY
# Other types than LINESTRING return NULL.
select ST_StartPoint(ST_Point(1, 2));
---- TYPES
BINARY
---- RESULTS
'NULL'
====
---- QUERY
# Other types than LINESTRING return NULL.
select ST_EndPoint(ST_Point(1, 2));
---- TYPES
BINARY
---- RESULTS
'NULL'
====
---- QUERY
# ST_IsRing - true if linestring is closed and simple
select ST_IsRing(ST_LineString(0,0, 3,4, 0,4, 0,0));
---- TYPES
BOOLEAN
---- RESULTS
true
====
---- QUERY
select ST_IsRing(ST_LineString(0,0, 3,4));
---- TYPES
BOOLEAN
---- RESULTS
false
====
---- QUERY
# Self-intersecting closed linestring is not a ring
select ST_IsRing(ST_LineString(0,0, 1,1, 1,2, 2,1, 1,1, 0,0));
---- TYPES
BOOLEAN
---- RESULTS
false
====
---- QUERY
# ST_NumInteriorRing
select ST_NumInteriorRing(ST_GeomFromText('POLYGON ((0 0, 0 10, 10 10, 10 0, 0 0))'));
---- TYPES
INT
---- RESULTS
0
====
---- QUERY
select ST_NumInteriorRing(
    ST_GeomFromText('POLYGON ((0 0, 0 10, 10 10, 10 0, 0 0), (2 2, 2 4, 4 4, 4 2, 2 2))'));
---- TYPES
INT
---- RESULTS
1
====
---- QUERY
select ST_NumInteriorRing(
    ST_GeomFromText('POLYGON ((0 0, 0 10, 10 10, 10 0, 0 0), (1 1, 1 3, 3 3, 3 1, 1 1), (5 5, 5 7, 7 7, 7 5, 5 5))'));
---- TYPES
INT
---- RESULTS
2
====
---- QUERY
# ST_GeomCollection - only supports multi-part geometries of the same type.
# True GEOMETRYCOLLECTION with mixed types returns NULL.
select ST_AsText(ST_GeomCollection('GEOMETRYCOLLECTION (POINT (1 2), LINESTRING (0 0, 1 1))'));
---- TYPES
STRING
---- RESULTS
'NULL'
====
---- QUERY
# ST_GeomCollection with MULTIPOINT (homogeneous collection) works.
select ST_AsText(ST_GeomCollection('MULTIPOINT ((1 2), (3 4))'));
---- TYPES
STRING
---- RESULTS
'MULTIPOINT ((1 2), (3 4))'
====
---- QUERY
select ST_NumGeometries(ST_GeomCollection('MULTIPOINT ((1 2), (3 4), (5 6))'));
---- TYPES
INT
---- RESULTS
3
====
---- QUERY
# ST_Union - union of two geometries
select ST_AsText(ST_Union(ST_Point(1, 2), ST_Point(3, 4)));
---- TYPES
STRING
---- RESULTS
'MULTIPOINT ((1 2), (3 4))'
====
---- QUERY
select ST_AsText(ST_Union(ST_GeomFromText('POLYGON ((0 0, 0 2, 2 2, 2 0, 0 0))'), ST_GeomFromText('POLYGON ((1 1, 1 3, 3 3, 3 1, 1 1))')));
---- TYPES
STRING
---- RESULTS
'POLYGON ((0 0, 2 0, 2 1, 3 1, 3 3, 1 3, 1 2, 0 2, 0 0))'
====
---- QUERY
# ST_Union with 3 arguments
select ST_AsText(ST_Union(ST_Point(1, 1), ST_Point(2, 2), ST_Point(3, 3)));
---- TYPES
STRING
---- RESULTS
'MULTIPOINT ((1 1), (2 2), (3 3))'
====
---- QUERY
select st_intersects(st_geomfromtext('LINESTRING(1 0, 1 1)'), st_geomfromtext('MULTILINESTRING((0 0, 0 1), (2 0, 2 1))'));
---- TYPES
BOOLEAN
---- RESULTS
false
====
---- QUERY
select st_intersects(st_geomfromtext('MULTILINESTRING((2 0, 2 2),(3 0, 3 2))'), st_geomfromtext('MULTILINESTRING((0 0, 0 2), (4 0, 4 2))'));
---- TYPES
BOOLEAN
---- RESULTS
false
====
---- QUERY
select st_intersects(st_geomfromtext('LINESTRING(1 0, 1 1)'), st_geomfromtext('MULTILINESTRING((-1 1, 2 1), (2 0, 2 1))'));
---- TYPES
BOOLEAN
---- RESULTS
true
====
---- QUERY
select st_intersects(st_geomfromtext('MULTILINESTRING((2 0, 2 2),(1 0, 1 1))'), st_geomfromtext('MULTILINESTRING((-1 1, 2 1), (2 0, 2 1))'));
---- TYPES
BOOLEAN
---- RESULTS
true
====
---- QUERY
select st_disjoint(st_geomfromtext('LINESTRING(1 0, 1 1)'), st_geomfromtext('MULTILINESTRING((0 0, 0 1), (2 0, 2 1))'));
---- TYPES
BOOLEAN
---- RESULTS
true
====
---- QUERY
select st_disjoint(st_geomfromtext('MULTILINESTRING((2 0, 2 2),(3 0, 3 2))'), st_geomfromtext('MULTILINESTRING((0 0, 0 2), (4 0, 4 2))'));
---- TYPES
BOOLEAN
---- RESULTS
true
====
---- QUERY
select st_disjoint(st_geomfromtext('LINESTRING(1 0, 1 1)'), st_geomfromtext('MULTILINESTRING((-1 1, 2 1), (2 0, 2 1))'));
---- TYPES
BOOLEAN
---- RESULTS
false
====
---- QUERY
select st_disjoint(st_geomfromtext('MULTILINESTRING((2 0, 2 2),(1 0, 1 1))'), st_geomfromtext('MULTILINESTRING((-1 1, 2 1), (2 0, 2 1))'));
---- TYPES
BOOLEAN
---- RESULTS
false
====
---- QUERY
# ST_DistanceSphere - great circle distance between points in meters
select cast(ST_DistanceSphere(ST_Point(0, 0), ST_Point(0, 1)) as bigint);
---- TYPES
BIGINT
---- RESULTS
111195
====
---- QUERY
# HK to Sydney
select cast(ST_DistanceSphere(ST_Point(113.914603, 22.308919), ST_Point(151.177222, -33.946111)) as bigint);
---- TYPES
BIGINT
---- RESULTS
7393893
====
---- QUERY
# HK to Toronto
select cast(ST_DistanceSphere(ST_Point(113.914603, 22.308919), ST_Point(-79.630556, 43.677223)) as bigint);
---- TYPES
BIGINT
---- RESULTS
12548548
====
---- QUERY
# Budapest Parliament to Buda Castle (~1.25 km)
select cast(ST_DistanceSphere(ST_Point(19.04572641312447, 47.50745742600276), ST_Point(19.04125284394088, 47.49660323441422)) as bigint);
---- TYPES
BIGINT
---- RESULTS
1252
====
---- QUERY
# Anti-meridian crossing: points near 180/-180 longitude should be close
select ST_DistanceSphere(ST_Point(179.999, 0), ST_Point(-179.999, 0)) < 300;
---- TYPES
BOOLEAN
---- RESULTS
true
====
---- QUERY
# Near the North Pole: opposite longitudes but both near 90 lat
select ST_DistanceSphere(ST_Point(-60, 89.999), ST_Point(120, 89.999)) < 300;
---- TYPES
BOOLEAN
---- RESULTS
true
====
---- QUERY
# Same point should give 0
select cast(ST_DistanceSphere(ST_Point(10, 20), ST_Point(10, 20)) as bigint);
---- TYPES
BIGINT
---- RESULTS
0
====