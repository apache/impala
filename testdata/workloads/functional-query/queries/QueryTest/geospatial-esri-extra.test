====
---- QUERY
# ST_DistanceSphere - great circle distance between points in meters
select cast(ST_DistanceSphere(ST_Point(0, 0), ST_Point(0, 1)) as bigint);
---- TYPES
BIGINT
---- RESULTS
111195
====
---- QUERY
select cast(ST_DistanceSphere(ST_Point(113.914603, 22.308919), ST_Point(151.177222, -33.946111)) as bigint);
---- TYPES
BIGINT
---- RESULTS
7393893
====
---- QUERY
select st_intersects(st_geomfromtext('LINESTRING(1 0, 1 1)'), st_geomfromtext('MULTILINESTRING((0 0, 0 1), (2 0, 2 1))'));
---- TYPES
BOOLEAN
---- RESULTS
false
====
---- QUERY
select st_intersects(st_geomfromtext('MULTILINESTRING((2 0, 2 2),(3 0, 3 2))'), st_geomfromtext('MULTILINESTRING((0 0, 0 2), (4 0, 4 2))'));
---- TYPES
BOOLEAN
---- RESULTS
false
====
---- QUERY
select st_intersects(st_geomfromtext('LINESTRING(1 0, 1 1)'), st_geomfromtext('MULTILINESTRING((-1 1, 2 1), (2 0, 2 1))'));
---- TYPES
BOOLEAN
---- RESULTS
true
====
---- QUERY
select st_intersects(st_geomfromtext('MULTILINESTRING((2 0, 2 2),(1 0, 1 1))'), st_geomfromtext('MULTILINESTRING((-1 1, 2 1), (2 0, 2 1))'));
---- TYPES
BOOLEAN
---- RESULTS
true
====
---- QUERY
select st_disjoint(st_geomfromtext('LINESTRING(1 0, 1 1)'), st_geomfromtext('MULTILINESTRING((0 0, 0 1), (2 0, 2 1))'));
---- TYPES
BOOLEAN
---- RESULTS
true
====
---- QUERY
select st_disjoint(st_geomfromtext('MULTILINESTRING((2 0, 2 2),(3 0, 3 2))'), st_geomfromtext('MULTILINESTRING((0 0, 0 2), (4 0, 4 2))'));
---- TYPES
BOOLEAN
---- RESULTS
true
====
---- QUERY
select st_disjoint(st_geomfromtext('LINESTRING(1 0, 1 1)'), st_geomfromtext('MULTILINESTRING((-1 1, 2 1), (2 0, 2 1))'));
---- TYPES
BOOLEAN
---- RESULTS
false
====
---- QUERY
select st_disjoint(st_geomfromtext('MULTILINESTRING((2 0, 2 2),(1 0, 1 1))'), st_geomfromtext('MULTILINESTRING((-1 1, 2 1), (2 0, 2 1))'));
---- TYPES
BOOLEAN
---- RESULTS
false
