=====
---- QUERY
select st_bin(1, "point empty")
---- TYPES
BIGINT
---- RESULTS
0
====
---- QUERY
select st_bin(1, "point(10 10)")
---- TYPES
BIGINT
---- RESULTS
4611685985093119520
====
---- QUERY
select st_bin(1.0, st_point(10, 10))
---- TYPES
BIGINT
---- RESULTS
4611685985093119520
====
---- QUERY
select st_bin(1.0, "point(-200 50)")
---- TYPES
BIGINT
---- RESULTS
4611685863613099350
====
---- QUERY
select st_bin(1, st_point(-200, 50))
---- TYPES
BIGINT
---- RESULTS
4611685863613099350
====
---- QUERY
select st_bin(1, "point(-500 -1000)")
---- TYPES
BIGINT
---- RESULTS
4611689052463623000
