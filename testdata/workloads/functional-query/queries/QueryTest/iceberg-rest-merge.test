# S20: insert-only MERGE on unpartitioned V3 (WHEN NOT MATCHED only).
INSERT INTO s20_target VALUES (1,'one'),(2,'two');
INSERT INTO s20_source VALUES (3,'three'),(4,'four');
====
---- QUERY
MERGE INTO s20_target USING s20_source ON s20_target.id = s20_source.id
WHEN NOT MATCHED THEN INSERT VALUES (s20_source.id, s20_source.val);
---- DML_RESULTS: s20_target
1,'one'
2,'two'
3,'three'
4,'four'
---- TYPES
INT,STRING
---- RUNTIME_PROFILE
# Insert-only on unpartitioned V3 must not shuffle on INPUT__FILE__NAME.
!row_regex: .*EXCHANGE \[HASH\(.*INPUT__FILE__NAME.*\).*
====
---- QUERY
# All rows have last_seq=1 (inserted) or last_seq=2 (newly inserted by MERGE).
SELECT id, val, _last_updated_sequence_number AS last_seq
FROM s20_target ORDER BY id;
---- RESULTS
1,'one',1
2,'two',1
3,'three',2
4,'four',2
---- TYPES
INT,STRING,BIGINT
====
---- QUERY
# S21: insert-only MERGE on partitioned V3 (identity on cat, WHEN NOT MATCHED only).
INSERT INTO s21_target VALUES (1,'A',10),(2,'B',20);
INSERT INTO s21_source VALUES (3,'A',30),(4,'C',40);
====
---- QUERY
MERGE INTO s21_target USING s21_source ON s21_target.id = s21_source.id
WHEN NOT MATCHED THEN INSERT VALUES (s21_source.id, s21_source.cat, s21_source.val);
---- DML_RESULTS: s21_target
1,'A',10
2,'B',20
3,'A',30
4,'C',40
---- TYPES
INT,STRING,INT
---- RUNTIME_PROFILE
# Insert-only partitioned V3 still shuffles on partition spec for correct file grouping.
row_regex: .*EXCHANGE \[HASH\(coalesce\(.*partition__spec__id.*murmur_hash\(.*cat.*\).*\).*
====
---- QUERY
# Existing rows keep seq=1; inserted rows get seq=2.
SELECT id, cat, val, _last_updated_sequence_number AS last_seq
FROM s21_target ORDER BY id;
---- RESULTS
1,'A',10,1
2,'B',20,1
3,'A',30,2
4,'C',40,2
---- TYPES
INT,STRING,INT,BIGINT
====
---- QUERY
# From the IMPALA-15065 regression test, only the MERGEs before its partition spec
# evolution. MERGE 1 inserts into the empty, bool_col-partitioned target_part, so it
# is the first commit on a table without snapshots. MERGE 2 writes DVs into both
# partitions. source gets the ids of the 1000 functional.alltypes rows; only
# id and int_col are checked.
insert into source
select cast(id as int), id % 2 = 0, cast(id % 10 as int),
  cast(id % 10 * 1.1 as float), cast(id % 10 * 10 as decimal(20,0)),
  date '2009-01-01', cast(id % 10 as string)
from (select a.d * 100 + b.d * 10 + c.d as id
      from (VALUES (0 d), (1), (2), (3), (4), (5), (6), (7), (8), (9)) a,
           (VALUES (0 d), (1), (2), (3), (4), (5), (6), (7), (8), (9)) b,
           (VALUES (0 d), (1), (2), (3), (4), (5), (6), (7), (8), (9)) c) t;
====
---- QUERY
# MERGE 1: fill target_part from source using WHEN NOT MATCHED INSERT.
# Target is empty so all 1000 source rows are inserted with id shifted by +1000.
merge into target_part target using source on target.id = source.id
when not matched then insert values(
    cast(source.id + 1000 as int), source.bool_col, source.int_col,
    source.float_col, source.decimal_col,
    source.date_col, 'constant string value');
====
---- QUERY
select count(*), sum(id), sum(int_col) from target_part
---- RESULTS
1000,1499500,4500
---- TYPES
BIGINT,BIGINT,BIGINT
====
---- QUERY
# MERGE 2: update all rows via WHEN MATCHED: id shifted back to source.id, int_col refreshed.
# Exercises DVs on a bool_col-partitioned table (two partitions: true/false).
merge into target_part target using (select * from source) source on target.id = source.id + 1000
when matched then update set int_col = source.int_col, id = source.id;
====
---- QUERY
select count(*), sum(id), sum(int_col) from target_part
---- RESULTS
1000,499500,4500
---- TYPES
BIGINT,BIGINT,BIGINT
====
---- QUERY
# Merge from/into table with some positional deletes
INSERT INTO s23 VALUES ('a'), ('b');
DELETE FROM s23 WHERE s='a';
INSERT INTO s23 VALUES ('c'), ('d'), ('e');
---- DML_RESULTS: s23
'b'
'c'
'd'
'e'
---- TYPES
STRING
====
---- QUERY
MERGE INTO s23 AS tgt USING (SELECT * from s23) AS src on src.s = tgt.s
WHEN MATCHED THEN DELETE
WHEN NOT MATCHED THEN INSERT (s) VALUES ("what");
---- DML_RESULTS: s23
---- TYPES
STRING
---- RUNTIME_PROFILE
# Unpartitioned V3 table must shuffle on INPUT__FILE__NAME to guarantee one
# Deletion Vector per data file.
row_regex: .*EXCHANGE \[HASH\(.*INPUT__FILE__NAME.*\)\].*
====
