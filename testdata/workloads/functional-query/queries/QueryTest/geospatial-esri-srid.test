'{"x":1.2,"y":2.4,"spatialReference":{"wkid":4326}}'
====
---- QUERY
select ST_AsJson(ST_GeomFromJson('{"x":1.2,"y":2.4,"spatialReference":{"wkid":4326}}'));
---- RESULTS
'{"x":1.2,"y":2.4,"spatialReference":{"wkid":4326}}'
