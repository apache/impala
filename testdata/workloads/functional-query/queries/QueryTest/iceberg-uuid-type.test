INT
====
---- QUERY
# IS DISTINCT FROM on different UUID values.
SELECT id FROM iceberg_uuid_test
WHERE uuid_col IS DISTINCT FROM CAST('12345678-1234-5678-1234-567812345678' AS UUID) AND id != 1
ORDER BY id
---- RESULTS
2
3
4
5
---- TYPES
INT
====
---- QUERY
# IS NOT DISTINCT FROM treats two NULL UUIDs as equal (scalar subquery).
SELECT id FROM iceberg_uuid_test
WHERE uuid_col IS NOT DISTINCT FROM (SELECT uuid_col FROM iceberg_uuid_test WHERE id = 4)
ORDER BY id
---- RESULTS
4
---- TYPES
INT
====
---- QUERY
# IS NOT DISTINCT FROM treats two NULL UUIDs as equal (CAST(NULL AS UUID)).
SELECT id FROM iceberg_uuid_test WHERE uuid_col IS NOT DISTINCT FROM CAST(NULL AS UUID)
---- RESULTS
4
