====
---- QUERY
# Iceberg UUID Parquet read-path tests.
# Casts, LIKE, and aggregates are not yet supported.
DESCRIBE iceberg_uuid_test
---- RESULTS: VERIFY_IS_SUBSET
'id','int','','true'
'uuid_col','uuid','','true'
'name','string','','true'
---- TYPES
STRING,STRING,STRING,STRING
====
---- QUERY
# DESCRIBE FORMATTED reports Iceberg table properties.
DESCRIBE FORMATTED iceberg_uuid_test
---- RESULTS: VERIFY_IS_SUBSET
'','format-version      ','3                   '
'','write.format.default','parquet             '
---- TYPES
STRING,STRING,STRING
====
---- QUERY
# Basic SELECT from Parquet Iceberg table with UUID column.
SELECT id, uuid_col, name FROM iceberg_uuid_test ORDER BY id
---- RESULTS
1,'12345678-1234-5678-1234-567812345678','alice'
2,'abcdefab-cdef-abcd-efab-cdefabcdefab','bob'
3,'00000000-0000-0000-0000-000000000000','zeros'
4,'NULL','null_uuid'
5,'ffffffff-ffff-ffff-ffff-ffffffffffff','max'
---- TYPES
INT,UUID,STRING
---- HS2_TYPES
INT,STRING,STRING
====
---- QUERY
# SHOW CREATE TABLE includes UUID column type.
SHOW CREATE TABLE iceberg_uuid_test
---- RESULTS: VERIFY_IS_SUBSET
row_regex: .*uuid_col UUID
---- TYPES
STRING
====
---- QUERY
# INSERT into Iceberg table with UUID column is blocked.
INSERT INTO iceberg_uuid_test VALUES (10, '11111111-1111-1111-1111-111111111111', 'test')
---- CATCH
Impala does not support writing UUID columns
====
---- QUERY
# CTAS with UUID column is blocked (write path not supported).
CREATE TABLE uuid_ctas
STORED AS ICEBERG
AS SELECT * FROM iceberg_uuid_test
---- CATCH
Impala does not support writing UUID columns
====
---- QUERY
# ORC format is not yet supported for UUID column reads.
SELECT id, uuid_col FROM iceberg_uuid_test_orc
---- CATCH
Reading UUID columns from ORC format is not yet supported
====
---- QUERY
# Avro format is not yet supported for UUID column reads.
SELECT id, uuid_col FROM iceberg_uuid_test_avro
---- CATCH
Reading UUID columns from AVRO format is not yet supported
====
---- QUERY
# Equality predicate on two UUID-typed operands (via scalar subquery).
SELECT id FROM iceberg_uuid_test WHERE uuid_col = (SELECT uuid_col FROM iceberg_uuid_test WHERE id = 1)
---- RESULTS
1
---- TYPES
INT
====
---- QUERY
# Inequality predicate on two UUID-typed operands.
SELECT id, name FROM iceberg_uuid_test
WHERE uuid_col != (SELECT uuid_col FROM iceberg_uuid_test WHERE id = 3) AND id = 5
ORDER BY id
---- RESULTS
5,'max'
---- TYPES
INT,STRING
====
---- QUERY
# IN predicate with a UUID-typed subquery.
SELECT id FROM iceberg_uuid_test
WHERE uuid_col IN (SELECT uuid_col FROM iceberg_uuid_test WHERE id IN (1, 2))
ORDER BY id
---- RESULTS
1
2
---- TYPES
INT
====
---- QUERY
# NOT IN predicate with a UUID-typed subquery.
# Rows with NULL uuid_col are excluded (NULL NOT IN (...) is unknown).
SELECT id FROM iceberg_uuid_test
WHERE uuid_col NOT IN (SELECT uuid_col FROM iceberg_uuid_test WHERE id IN (1, 2))
ORDER BY id
---- RESULTS
3
5
---- TYPES
INT
====
---- QUERY
# Range comparison predicates on UUID-typed operands.
SELECT id, name FROM iceberg_uuid_test
WHERE uuid_col > (SELECT uuid_col FROM iceberg_uuid_test WHERE id = 3)
  AND uuid_col < (SELECT uuid_col FROM iceberg_uuid_test WHERE id = 5)
ORDER BY uuid_col DESC
---- RESULTS
2,'bob'
1,'alice'
---- TYPES
INT,STRING
====
---- QUERY
# BETWEEN predicate on UUID-typed operands.
SELECT id FROM iceberg_uuid_test
WHERE uuid_col BETWEEN
  (SELECT uuid_col FROM iceberg_uuid_test WHERE id = 1)
  AND (SELECT uuid_col FROM iceberg_uuid_test WHERE id = 2)
ORDER BY id
---- RESULTS
1
2
---- TYPES
INT
====
---- QUERY
# JOIN on a UUID column exercises UUID equality.
SELECT a.id FROM iceberg_uuid_test a
JOIN iceberg_uuid_test b ON a.uuid_col = b.uuid_col AND b.id = 1
ORDER BY a.id
---- RESULTS
1
---- TYPES
INT
====
---- QUERY
# STRING literals are not implicitly cast to UUID.
SELECT id FROM iceberg_uuid_test WHERE uuid_col = '12345678-1234-5678-1234-567812345678'
---- CATCH
operands of type UUID and STRING are not comparable
====
---- QUERY
# STRING literals in IN lists are not implicitly cast to UUID.
SELECT id FROM iceberg_uuid_test
WHERE uuid_col IN ('12345678-1234-5678-1234-567812345678', 'abcdefab-cdef-abcd-efab-cdefabcdefab')
---- CATCH
Incompatible return types 'UUID' and 'STRING'
====
---- QUERY
# STRING literals in BETWEEN are not implicitly cast to UUID.
SELECT id FROM iceberg_uuid_test
WHERE uuid_col BETWEEN '12345678-1234-5678-1234-567812345678' AND 'abcdefab-cdef-abcd-efab-cdefabcdefab'
---- CATCH
Incompatible return types 'UUID' and 'STRING'
====
---- QUERY
# IS NULL and IS NOT NULL on UUID columns.
SELECT
  sum(case when uuid_col IS NULL then 1 else 0 end),
  sum(case when uuid_col IS NOT NULL then 1 else 0 end)
FROM iceberg_uuid_test
---- RESULTS
1,4
---- TYPES
BIGINT,BIGINT
====
---- QUERY
SELECT id FROM iceberg_uuid_test WHERE uuid_col IS NULL ORDER BY id
---- RESULTS
4
---- TYPES
INT
====
---- QUERY
SELECT id FROM iceberg_uuid_test WHERE uuid_col IS NOT NULL ORDER BY id
---- RESULTS
1
2
3
5
---- TYPES
INT
====
---- QUERY
# IS NOT DISTINCT FROM on equal UUID values (null-safe equality).
SELECT id FROM iceberg_uuid_test a
WHERE a.uuid_col IS NOT DISTINCT FROM (SELECT uuid_col FROM iceberg_uuid_test WHERE id = 1)
ORDER BY id
---- RESULTS
1
---- TYPES
INT
====
---- QUERY
# IS DISTINCT FROM on different UUID values.
SELECT id FROM iceberg_uuid_test
WHERE uuid_col IS DISTINCT FROM (SELECT uuid_col FROM iceberg_uuid_test WHERE id = 1) AND id != 1
ORDER BY id
---- RESULTS
2
3
4
5
---- TYPES
INT
====
---- QUERY
# IS NOT DISTINCT FROM treats two NULL UUIDs as equal.
SELECT id FROM iceberg_uuid_test
WHERE uuid_col IS NOT DISTINCT FROM (SELECT uuid_col FROM iceberg_uuid_test WHERE id = 4)
ORDER BY id
---- RESULTS
4
---- TYPES
INT
====
---- QUERY
# IS DISTINCT FROM treats NULL and non-NULL UUIDs as distinct.
SELECT id FROM iceberg_uuid_test
WHERE uuid_col IS DISTINCT FROM (SELECT uuid_col FROM iceberg_uuid_test WHERE id = 1)
ORDER BY id
---- RESULTS
2
3
4
5
---- TYPES
INT
====
---- QUERY
# JOIN on IS NOT DISTINCT FROM supports null-safe UUID equality.
SELECT a.id FROM iceberg_uuid_test a
JOIN iceberg_uuid_test b ON a.uuid_col IS NOT DISTINCT FROM b.uuid_col AND b.id = 4
ORDER BY a.id
---- RESULTS
4
---- TYPES
INT
====
---- QUERY
# STRING literals are not implicitly cast for IS DISTINCT FROM.
SELECT id FROM iceberg_uuid_test
WHERE uuid_col IS DISTINCT FROM '12345678-1234-5678-1234-567812345678'
---- CATCH
operands of type UUID and STRING are not comparable
====
---- QUERY
# STRING literals are not implicitly cast for IS NOT DISTINCT FROM.
SELECT id FROM iceberg_uuid_test
WHERE uuid_col IS NOT DISTINCT FROM '12345678-1234-5678-1234-567812345678'
---- CATCH
operands of type UUID and STRING are not comparable
====
---- QUERY
# String functions require a cast; UUID is not implicitly converted to STRING.
SELECT length(uuid_col) FROM iceberg_uuid_test WHERE id = 1
---- CATCH
No matching function with signature: length(UUID)
====
---- QUERY
# LIKE predicates are not yet supported on UUID columns.
SELECT id FROM iceberg_uuid_test WHERE uuid_col LIKE 'ffffffff%'
---- CATCH
left operand of LIKE must be of type STRING
====
---- QUERY
# Explicit CAST from UUID to STRING is not yet supported.
SELECT CAST(uuid_col AS STRING) FROM iceberg_uuid_test WHERE id = 1
---- CATCH
Invalid type cast of uuid_col from UUID to STRING
====
---- QUERY
# Explicit CAST from STRING to UUID is not yet supported.
SELECT CAST('12345678-1234-5678-1234-567812345678' AS UUID)
---- CATCH
Invalid type cast of '12345678-1234-5678-1234-567812345678' from STRING to UUID
====
---- QUERY
# UUID cannot be cast to non-string types.
SELECT CAST(uuid_col AS INT) FROM iceberg_uuid_test WHERE id = 1
---- CATCH
Invalid type cast of uuid_col from UUID to INT
====
---- QUERY
# MIN() is not yet supported on UUID columns.
SELECT MIN(uuid_col) FROM iceberg_uuid_test
---- CATCH
No matching function with signature: min(UUID)
====
---- QUERY
# MAX() is not yet supported on UUID columns.
SELECT MAX(uuid_col) FROM iceberg_uuid_test
---- CATCH
No matching function with signature: max(UUID)
====
---- QUERY
# COUNT(uuid_col) is not yet supported on UUID columns.
SELECT COUNT(uuid_col) FROM iceberg_uuid_test
---- CATCH
No matching function with signature: count(UUID)
====
---- QUERY
# COUNT(*) works on tables with UUID columns (doesn't require aggregate on UUID).
SELECT COUNT(*) FROM iceberg_uuid_test
---- RESULTS
5
---- TYPES
BIGINT
====
---- QUERY
# AVG() is not supported on UUID columns.
SELECT AVG(uuid_col) FROM iceberg_uuid_test
---- CATCH
AVG requires a numeric or timestamp parameter
====
---- QUERY
# SUM() is not supported on UUID columns.
SELECT SUM(uuid_col) FROM iceberg_uuid_test
---- CATCH
SUM requires a numeric parameter: sum(uuid_col)
====
---- QUERY
# ORDER BY on UUID column.
SELECT uuid_col FROM iceberg_uuid_test ORDER BY uuid_col
---- RESULTS
'00000000-0000-0000-0000-000000000000'
'12345678-1234-5678-1234-567812345678'
'abcdefab-cdef-abcd-efab-cdefabcdefab'
'ffffffff-ffff-ffff-ffff-ffffffffffff'
'NULL'
---- TYPES
UUID
---- HS2_TYPES
STRING
====
---- QUERY
# SELECT DISTINCT on UUID column.
SELECT DISTINCT uuid_col FROM iceberg_uuid_test ORDER BY uuid_col
---- RESULTS
'00000000-0000-0000-0000-000000000000'
'12345678-1234-5678-1234-567812345678'
'abcdefab-cdef-abcd-efab-cdefabcdefab'
'ffffffff-ffff-ffff-ffff-ffffffffffff'
'NULL'
---- TYPES
UUID
---- HS2_TYPES
STRING
====
---- QUERY
# GROUP BY on UUID column.
SELECT uuid_col, COUNT(*) FROM iceberg_uuid_test GROUP BY uuid_col ORDER BY uuid_col
---- RESULTS
'00000000-0000-0000-0000-000000000000',1
'12345678-1234-5678-1234-567812345678',1
'abcdefab-cdef-abcd-efab-cdefabcdefab',1
'ffffffff-ffff-ffff-ffff-ffffffffffff',1
'NULL',1
---- TYPES
UUID,BIGINT
---- HS2_TYPES
STRING,BIGINT
====
---- QUERY
# HAVING with a non-boolean UUID expression is rejected at analysis time.
SELECT uuid_col FROM iceberg_uuid_test GROUP BY uuid_col HAVING uuid_col
---- CATCH
HAVING clause 'uuid_col' requires return type 'BOOLEAN'. Actual type is 'UUID'.
====
