---- QUERY
# Fixed-width CHAR output is available via an explicit UUID to STRING cast first.
SELECT CAST(CAST(uuid_col AS STRING) AS CHAR(36)) FROM iceberg_uuid_test WHERE id = 1
---- RESULTS
'12345678-1234-5678-1234-567812345678'
---- TYPES
CHAR
====
