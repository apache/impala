---- QUERY
# String functions require a cast; UUID is not implicitly converted to STRING.
SELECT length(uuid_col) FROM iceberg_uuid_test WHERE id = 1
---- CATCH
No matching function with signature: length(UUID)
====
---- QUERY
# LIKE predicates are not yet supported on UUID columns.
SELECT id FROM iceberg_uuid_test WHERE uuid_col LIKE 'ffffffff%'
---- CATCH
left operand of LIKE must be of type STRING
====
---- QUERY
# Explicit CAST from UUID to STRING.
SELECT CAST(uuid_col AS STRING) FROM iceberg_uuid_test WHERE id = 1
---- RESULTS
'12345678-1234-5678-1234-567812345678'
---- TYPES
STRING
====
---- QUERY
# Explicit CAST from STRING to UUID.
SELECT CAST('12345678-1234-5678-1234-567812345678' AS UUID)
---- RESULTS
'12345678-1234-5678-1234-567812345678'
---- TYPES
UUID
---- HS2_TYPES
STRING
====
---- QUERY
# CAST from STRING to UUID rejects invalid canonical strings at runtime.
SELECT CAST('invalid-uuid-format' AS UUID)
---- CATCH
String to UUID parse failed. Invalid string val: 'invalid-uuid-format'
====
---- QUERY
# CAST from STRING to UUID rejects strings without dashes.
SELECT CAST('12345678123456781234567812345678' AS UUID)
---- CATCH
String to UUID parse failed. Invalid string val: '12345678123456781234567812345678'
====
---- QUERY
# CAST from STRING to UUID rejects brace-wrapped strings.
SELECT CAST('{12345678-1234-5678-1234-567812345678}' AS UUID)
---- CATCH
String to UUID parse failed. Invalid string val: '{12345678-1234-5678-1234-567812345678}'
====
---- QUERY
# CAST from STRING to UUID rejects leading or trailing whitespace.
SELECT CAST(' 12345678-1234-5678-1234-567812345678 ' AS UUID)
---- CATCH
String to UUID parse failed. Invalid string val: ' 12345678-1234-5678-1234-567812345678 '
====
---- QUERY
# CAST from STRING to UUID rejects empty strings.
SELECT CAST('' AS UUID)
---- CATCH
String to UUID parse failed. Invalid string val: ''
====
---- QUERY
# Uppercase UUID input is accepted and normalized to lowercase on output.
SELECT CAST(CAST('ABCDEFAB-CDEF-ABCD-EFAB-CDEFABCDEFAB' AS UUID) AS STRING)
---- RESULTS
'abcdefab-cdef-abcd-efab-cdefabcdefab'
---- TYPES
STRING
====
---- QUERY
# Non-constant STRING expression preserves UUID values.
SELECT count(*) FROM iceberg_uuid_test WHERE CAST(CAST(uuid_col AS STRING) AS UUID) = uuid_col AND uuid_col IS NOT NULL
---- RESULTS
4
---- TYPES
BIGINT
====
