---- QUERY
# GROUP BY with UUID and other aggregate functions.
SELECT
  uuid_col,
  COUNT(*) as cnt,
  MIN(name) as min_name,
  MAX(name) as max_name
FROM iceberg_uuid_test
WHERE uuid_col IS NOT NULL
GROUP BY uuid_col
ORDER BY uuid_col
