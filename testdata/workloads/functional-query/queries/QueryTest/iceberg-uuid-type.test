# INSERT with an explicit UUID cast is still blocked on the write path.
INSERT INTO iceberg_uuid_test
VALUES (10, CAST('12345678-1234-5678-1234-567812345678' AS UUID), 'test')
---- CATCH
Impala does not support writing UUID columns
====
---- QUERY
# CTAS producing UUID columns in Parquet is blocked (Iceberg-only type).
CREATE TABLE uuid_cast_ctas_parquet
STORED AS PARQUET
AS SELECT CAST('12345678-1234-5678-1234-567812345678' AS UUID) AS u
---- CATCH
UUID type is only supported for Iceberg tables
====
---- QUERY
# CTAS producing UUID columns in Iceberg is blocked on the write path.
CREATE TABLE uuid_cast_ctas_iceberg
STORED AS ICEBERG
AS SELECT CAST('12345678-1234-5678-1234-567812345678' AS UUID) AS u
---- CATCH
Impala does not support writing UUID columns
