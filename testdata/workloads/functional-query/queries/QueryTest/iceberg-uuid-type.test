SELECT CAST(uuid_col AS CHAR(30)) FROM iceberg_uuid_test WHERE id = 1
---- CATCH
Invalid type cast of uuid_col from UUID to CHAR(30)
====
---- QUERY
# CAST from UUID to VARCHAR is rejected; use CAST(uuid AS STRING) instead.
SELECT CAST(uuid_col AS VARCHAR(36)) FROM iceberg_uuid_test WHERE id = 1
---- CATCH
Invalid type cast of uuid_col from UUID to VARCHAR(36)
