SELECT CAST(CAST('12345678-1234-5678-1234-567812345678' AS CHAR(36)) AS UUID)
---- RESULTS
'12345678-1234-5678-1234-567812345678'
---- TYPES
UUID
---- HS2_TYPES
STRING
