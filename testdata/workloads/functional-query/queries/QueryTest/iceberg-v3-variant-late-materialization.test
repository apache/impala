====
---- QUERY
# The rows of iceberg_v3_variant_multipage carry their file position in 'pos' and in the
# 'pos' field of v and v2, so most queries check that the values landed on the right rows:
# the number of rows, of non-NULL v values, of v values on the right row, the same two for
# v2 and the number of rows with the right FILE__POSITION.
# Here survivors are scattered over all pages and row groups. v is the first slot, so a
# variant reader also drives the scan.
SELECT count(*), count(variant_get(v, '$.pos', 'bigint')),
  sum(if(variant_get(v, '$.pos', 'bigint') = pos, 1, 0)),
  count(variant_get(v2, '$.pos', 'bigint')),
  sum(if(variant_get(v2, '$.pos', 'bigint') = pos, 1, 0)),
  sum(if(file__position = pos, 1, 0))
FROM iceberg_v3_variant_multipage WHERE grp = 3;
---- RESULTS
42,35,35,25,25,42
---- TYPES
BIGINT, BIGINT, BIGINT, BIGINT, BIGINT, BIGINT
====
---- QUERY
# Most rows survive, so the skips are short.
SELECT count(*), count(variant_get(v, '$.pos', 'bigint')),
  sum(if(variant_get(v, '$.pos', 'bigint') = pos, 1, 0)),
  count(variant_get(v2, '$.pos', 'bigint')),
  sum(if(variant_get(v2, '$.pos', 'bigint') = pos, 1, 0)),
  sum(if(file__position = pos, 1, 0))
FROM iceberg_v3_variant_multipage WHERE grp != 3;
---- RESULTS
378,326,326,236,236,378
---- TYPES
BIGINT, BIGINT, BIGINT, BIGINT, BIGINT, BIGINT
====
---- QUERY
# The first and last rows of the file and of each row group.
SELECT id, file__position, v, v2 FROM iceberg_v3_variant_multipage
WHERE id IN (0, 1, 2, 158, 159, 160, 161, 299, 300, 301, 418, 419);
