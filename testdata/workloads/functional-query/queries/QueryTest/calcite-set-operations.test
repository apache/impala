---- QUERY
# UNION compares decimal values after conversion to the common type.
with a as (
  select cast(1234567.89 as decimal(9, 2)) v
  union all select cast(1.23 as decimal(9, 2))
  union all select cast(null as decimal(9, 2))
), b as (
  select cast(1.230 as decimal(9, 3)) v
  union all select cast(123456.789 as decimal(9, 3))
  union all select cast(null as decimal(9, 3))
)
select * from a union select * from b
---- TYPES
DECIMAL
---- RESULTS
1234567.890
1.230
123456.789
NULL
---- RUNTIME_PROFILE
row_regex: PlannerType: CalcitePlanner
====
---- QUERY
# INTERSECT matches equal decimals with different scales and matches NULLs.
with a as (
  select cast(1234567.89 as decimal(9, 2)) v
  union all select cast(1.23 as decimal(9, 2))
  union all select cast(null as decimal(9, 2))
), b as (
  select cast(1.230 as decimal(9, 3)) v
  union all select cast(123456.789 as decimal(9, 3))
  union all select cast(null as decimal(9, 3))
)
select * from a intersect select * from b
---- TYPES
DECIMAL
---- RESULTS
1.230
NULL
---- RUNTIME_PROFILE
row_regex: PlannerType: CalcitePlanner
====
---- QUERY
# EXCEPT removes equal decimals and NULLs after conversion to the common type.
with a as (
  select cast(1234567.89 as decimal(9, 2)) v
  union all select cast(1.23 as decimal(9, 2))
  union all select cast(null as decimal(9, 2))
), b as (
  select cast(1.230 as decimal(9, 3)) v
  union all select cast(123456.789 as decimal(9, 3))
  union all select cast(null as decimal(9, 3))
)
select * from a except select * from b
---- TYPES
DECIMAL
---- RESULTS
1234567.890
---- RUNTIME_PROFILE
row_regex: PlannerType: CalcitePlanner
====
---- QUERY
# Impala gives UNION and INTERSECT equal precedence and groups left to right.
select 100 union select 101 intersect select 101
---- TYPES
TINYINT
---- RESULTS
101
---- RUNTIME_PROFILE
row_regex: PlannerType: CalcitePlanner
====
---- QUERY
# Parentheses override the default grouping of UNION and INTERSECT.
select 100 union (select 101 intersect select 101)
---- TYPES
TINYINT
---- RESULTS
100
101
---- RUNTIME_PROFILE
row_regex: PlannerType: CalcitePlanner
