====
---- QUERY
# UNION ALL keeps duplicates within an input and across inputs, including NULLs.
with a as (
  select 1 id, cast(null as int) v union all select 1, null
  union all select cast(null as tinyint), 2 union all select 1, 2
  union all select cast(null as tinyint), 2
  union all select 3, 3
), b as (
  select 1 id, cast(null as int) v union all select cast(null as tinyint), null
  union all select 1, 2 union all select 1, 2 union all select 4, 4
)
select * from a union all select * from b
---- TYPES
TINYINT, INT
---- RESULTS
1,NULL
1,NULL
NULL,2
1,2
NULL,2
3,3
1,NULL
NULL,NULL
1,2
1,2
4,4
---- RUNTIME_PROFILE
row_regex: PlannerType: CalcitePlanner
====
---- QUERY
# DISTINCT compares the whole row and treats NULLs as equal.
with a as (
  select 1 id, cast(null as int) v union all select 1, null
  union all select cast(null as tinyint), 2 union all select 1, 2
  union all select cast(null as tinyint), 2
  union all select 3, 3
), b as (
  select 1 id, cast(null as int) v union all select cast(null as tinyint), null
  union all select 1, 2 union all select 1, 2 union all select 4, 4
)
select * from a union distinct select * from b
---- TYPES
TINYINT, INT
---- RESULTS
1,NULL
NULL,2
1,2
3,3
NULL,NULL
4,4
---- RUNTIME_PROFILE
row_regex: PlannerType: CalcitePlanner
====
---- QUERY
# Repeated rows on either side contribute only once to INTERSECT.
with a as (
  select 1 id, cast(null as int) v union all select 1, null
  union all select cast(null as tinyint), 2 union all select 1, 2
  union all select cast(null as tinyint), 2
  union all select 3, 3
), b as (
  select 1 id, cast(null as int) v union all select cast(null as tinyint), null
  union all select 1, 2 union all select 1, 2 union all select 4, 4
)
select * from a intersect select * from b
---- TYPES
TINYINT, INT
---- RESULTS
1,NULL
1,2
---- RUNTIME_PROFILE
row_regex: PlannerType: CalcitePlanner
====
---- QUERY
# A matching row removes every copy from the left input. Matching only one
# column does not remove a row, even when that column is NULL. Repeated rows
# that survive appear only once.
with a as (
  select 1 id, cast(null as int) v union all select 1, null
  union all select cast(null as tinyint), 2 union all select 1, 2
  union all select cast(null as tinyint), 2
  union all select 3, 3
), b as (
  select 1 id, cast(null as int) v union all select cast(null as tinyint), null
  union all select 1, 2 union all select 1, 2 union all select 4, 4
)
select * from a except select * from b
---- TYPES
TINYINT, INT
---- RESULTS
NULL,2
3,3
---- RUNTIME_PROFILE
row_regex: PlannerType: CalcitePlanner
====
---- QUERY
# EXCEPT must check every later input, not only the second one.
with a as (
  select 1 id, cast(null as int) v union all select 1, null
  union all select cast(null as tinyint), 2 union all select 1, 2
  union all select cast(null as tinyint), 2
  union all select 3, 3
), b as (
  select 1 id, cast(null as int) v union all select cast(null as tinyint), null
  union all select 1, 2 union all select 1, 2 union all select 4, 4
)
select * from a except select * from b except select 3, 3
---- TYPES
TINYINT, INT
---- RESULTS
NULL,2
---- RUNTIME_PROFILE
row_regex: PlannerType: CalcitePlanner
====
---- QUERY
# No row belongs to all three inputs, although each pair has a common row.
with a as (
  select 1 id, cast(null as int) v union all select 2, 2
), b as (
  select 1 id, cast(null as int) v union all select 3, 3
), c as (
  select 2 id, 2 v union all select 3, 3
)
select * from a intersect select * from b intersect select * from c
---- TYPES
TINYINT, INT
---- RESULTS
---- RUNTIME_PROFILE
row_regex: PlannerType: CalcitePlanner
====
---- QUERY
# A row shared by all three inputs appears once, including a row with NULL.
with a as (
  select 1 id, cast(null as int) v union all select 1, null union all select 2, 2
), b as (
  select 1 id, cast(null as int) v union all select 3, 3
), c as (
  select 1 id, cast(null as int) v union all select 1, null union all select 3, 3
)
select * from a intersect select * from b intersect select * from c
---- TYPES
TINYINT, INT
---- RESULTS
1,NULL
---- RUNTIME_PROFILE
row_regex: PlannerType: CalcitePlanner
====
---- QUERY
# EXCEPT still removes duplicates after pruning a known empty right input.
with a as (
  select 1 id, cast(null as int) v union all select 1, null union all select 2, 2
), b as (
  select cast(null as tinyint) id, cast(null as int) v
  from (select 1) t where false
)
select * from a except select * from b
---- TYPES
TINYINT, INT
---- RESULTS
1,NULL
2,2
---- RUNTIME_PROFILE
row_regex: PlannerType: CalcitePlanner
====
---- QUERY
# EXCEPT removes duplicates when the right input produces no rows at runtime.
with a as (
  select 1 id, cast(null as int) v union all select 1, null union all select 2, 2
), b as (
  select cast(id as tinyint) id, int_col v from alltypestiny where id = -1
)
select * from a except select * from b
---- TYPES
TINYINT, INT
---- RESULTS
1,NULL
2,2
---- RUNTIME_PROFILE
row_regex: PlannerType: CalcitePlanner
row_regex: .*HDFS_SCAN_NODE.*
====
---- QUERY
# EXCEPT returns no rows when the left input produces no rows at runtime.
with a as (
  select 1 id, cast(null as int) v union all select 1, null union all select 2, 2
), b as (
  select cast(id as tinyint) id, int_col v from alltypestiny where id = -1
)
select * from b except select * from a
---- TYPES
TINYINT, INT
---- RESULTS
---- RUNTIME_PROFILE
row_regex: PlannerType: CalcitePlanner
row_regex: .*HDFS_SCAN_NODE.*
====
---- QUERY
# INTERSECT returns no rows when one input produces no rows at runtime.
with a as (
  select 1 id, cast(null as int) v union all select 1, null union all select 2, 2
), b as (
  select cast(id as tinyint) id, int_col v from alltypestiny where id = -1
)
select * from a intersect select * from b
---- TYPES
TINYINT, INT
---- RESULTS
---- RUNTIME_PROFILE
