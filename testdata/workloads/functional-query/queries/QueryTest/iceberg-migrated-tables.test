---- QUERY
# Create a table that is identity-partitioned by all of its columns.
create table only_part_cols (i int, s string)
partitioned by spec (i, s)
stored as iceberg;
insert into only_part_cols values (1, 'i'), (1, 'i'), (2, 's'), (2, 'q');
select * from only_part_cols;
---- RESULTS
1,'i'
1,'i'
2,'q'
2,'s'
---- TYPES
INT, STRING
====
---- QUERY
select * from only_part_cols
where i = 2 and s = 's'
---- RESULTS
2,'s'
---- TYPES
INT, STRING
====
---- QUERY
# Strings written without the UTF8 annotation become binary in the Iceberg metrics of
# migrated files, and their bounds are truncated to 16 bytes, possibly in the middle of
# a character. Iceberg fails to decode such bounds as strings, so the scan is planned
# without pushing down the predicates.
set parquet_annotate_strings_utf8=false;
create table migrated_utf8_tbl (s string) partitioned by (p int) stored as parquet;
insert into migrated_utf8_tbl partition (p=1) values ('中文中文中文');
alter table migrated_utf8_tbl convert to iceberg;
select count(*) from migrated_utf8_tbl where p = 1 and s = 'x';
---- TYPES
BIGINT
---- RESULTS
0
====
---- QUERY
select count(*) from migrated_utf8_tbl where p = 1 and s = '中文中文中文';
---- TYPES
BIGINT
---- RESULTS
1
====
---- QUERY
# The same with time travel, which always uses Iceberg for planning.
select count(*) from migrated_utf8_tbl for system_time as of now()
where p = 1 and s = 'x';
---- TYPES
BIGINT
---- RESULTS
0
---- RUNTIME_PROFILE
result-data-files: 1
====
---- QUERY
# The same with delete files, the state of the failed planning is discarded.
alter table migrated_utf8_tbl set tblproperties ('format-version'='2');
insert into migrated_utf8_tbl values ('中文中文中文中文', 1);
delete from migrated_utf8_tbl where s = '中文中文中文';
select length(s) from migrated_utf8_tbl where p = 1 and s > 'a';
---- TYPES
INT
---- RESULTS
24
====
---- QUERY
select length(s) from migrated_utf8_tbl for system_time as of now()
where p = 1 and s > 'a';
---- TYPES
INT
---- RESULTS
24
====
---- QUERY
# The same if the predicates are pushed down because of the push down hint.
alter table migrated_utf8_tbl set tblproperties ('impala.iceberg.push_down_hint'='s');
select length(s) from migrated_utf8_tbl where s > 'a';
---- TYPES
INT
---- RESULTS
24
====
