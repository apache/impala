---- QUERY
# Test uneven scan distribution.
set mt_dop=2;
with a as (select s_suppkey from tpch.supplier where s_nationkey > 1),
  b as (select l_suppkey from tpch.lineitem where l_quantity > 2.0)
select distinct(k) from (
  select s_suppkey as k from a
  union all select l_suppkey as k from b
  union all select s_suppkey as k from a
  union all select l_suppkey as k from b) order by k limit 5;
---- RESULTS: VERIFY_IS_EQUAL
1
2
3
4
5
====
---- QUERY
# Test early consumer close.
with a as (select s_suppkey from tpch.supplier where s_nationkey > 1),
  b as (select l_suppkey from tpch.lineitem where l_quantity > 2.0)
select distinct(k) from (
  select s_suppkey as k from a limit 1
  union all select l_suppkey as k from b limit 1
  union all select s_suppkey as k from a
  union all select l_suppkey as k from b) order by k limit 5;
---- RESULTS: VERIFY_IS_EQUAL
1
2
3
4
5
