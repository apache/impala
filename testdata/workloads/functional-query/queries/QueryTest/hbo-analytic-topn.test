====
---- QUERY
# EXPLAIN the same query that has been executed
# Use DISTRIBUTEDPLAN (explain_level=2) to show the cardinality of MERGING-EXCHANGE.
EXPLAIN select * from (
  select id, int_col, rank() over (
    partition by int_col, string_col order by id) rnk
  from functional.alltypes
  where string_col != 'test_analytic_topn') t
where rnk <= 5
