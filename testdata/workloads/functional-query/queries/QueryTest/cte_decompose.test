====
---- QUERY
# For each market segment, find segments where sales in the United States exceeded sales in Russia.
WITH segment_sales AS (
SELECT c.c_mktsegment AS segment,
  c.c_nationkey AS nationkey,
  SUM(o.o_totalprice) AS total_sales
FROM orders o
JOIN customer c
  ON c.c_custkey = o.o_custkey
GROUP BY c.c_mktsegment, c.c_nationkey)

SELECT
    n1.n_name,
    ss1.segment,
    ss1.total_sales,
    n2.n_name,
    ss2.segment,
    ss2.total_sales
FROM
    segment_sales ss1,
    segment_sales ss2,
    nation n1,
    nation n2
WHERE ss1.nationkey = n1.n_nationkey AND
  n1.n_name = 'RUSSIA' AND
  ss2.nationkey = n2.n_nationkey AND
  n2.n_name = 'UNITED STATES' AND
  ss1.segment = ss2.segment AND
  ss1.total_sales < ss2.total_sales;
---- RESULTS
'RUSSIA','FURNITURE',1874971260.61,'UNITED STATES','FURNITURE',1876651158.20
---- TYPES
STRING, STRING, DECIMAL, STRING, STRING, DECIMAL
