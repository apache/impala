====
---- QUERY
# First phase of a distinct agg can reuse the stats if the GROUP BY keys match.
EXPLAIN SELECT int_col, count(distinct bigint_col) FROM functional.alltypes
 WHERE year = 2009 and string_col != 'test_agg' GROUP BY int_col
---- PLAN
PLAN-ROOT SINK
|
07:EXCHANGE [UNPARTITIONED]
|
06:AGGREGATE [FINALIZE]
|  output: count:merge(bigint_col)
|  group by: int_col
|  row-size=12B cardinality=10
|
05:EXCHANGE [HASH(int_col)]
|
02:AGGREGATE [STREAMING]
|  output: count(bigint_col)
|  group by: int_col
|  row-size=12B cardinality=10
|
04:AGGREGATE
|  group by: int_col, bigint_col
|  row-size=12B cardinality=10 (from HBO)
|
03:EXCHANGE [HASH(int_col,bigint_col)]
|
01:AGGREGATE [STREAMING]
|  group by: int_col, bigint_col
|  row-size=12B cardinality=30 (from HBO)
|
00:SCAN HDFS [functional.alltypes]
   partition predicates: `year` = 2009
   HDFS partitions=12/24 files=12 size=238.68KB
   predicates: string_col != 'test_agg'
   row-size=25B cardinality=3.65K (from HBO)
