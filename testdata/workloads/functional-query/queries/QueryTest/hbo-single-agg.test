====
---- QUERY
# inline view alias won't lead to wrong usage
EXPLAIN SELECT distinct int_col, bigint_col FROM (
  SELECT string_col as bigint_col, smallint_col as int_col
  FROM functional.alltypes
  WHERE year = 2009 and string_col != 'test_agg'
  GROUP BY bigint_col, int_col) t
---- PLAN
PLAN-ROOT SINK
|
05:EXCHANGE [UNPARTITIONED]
|
02:AGGREGATE [FINALIZE]
|  group by: smallint_col, string_col
|  row-size=15B cardinality=100
|
04:AGGREGATE [FINALIZE]
|  group by: string_col, smallint_col
|  row-size=15B cardinality=100
|
03:EXCHANGE [HASH(string_col,smallint_col)]
|
01:AGGREGATE [STREAMING]
|  group by: string_col, smallint_col
|  row-size=15B cardinality=300
|
00:SCAN HDFS [functional.alltypes]
   partition predicates: `year` = 2009
   HDFS partitions=12/24 files=12 size=238.68KB
   predicates: string_col != 'test_agg'
   row-size=15B cardinality=3.65K (from HBO)
====
---- QUERY
# inline view alias won't lead to wrong usage
EXPLAIN SELECT distinct int_col, bigint_col FROM (
  SELECT string_col, count(int_col) int_col, count(bigint_col) as bigint_col
  FROM functional.alltypes
  WHERE year = 2009 and string_col != 'test_agg'
  GROUP BY string_col) t
---- PLAN
PLAN-ROOT SINK
|
07:EXCHANGE [UNPARTITIONED]
|
06:AGGREGATE [FINALIZE]
|  group by: int_col, bigint_col
|  row-size=16B cardinality=10
|
05:EXCHANGE [HASH(int_col,bigint_col)]
|
02:AGGREGATE [STREAMING]
|  group by: count(int_col), count(bigint_col)
|  row-size=16B cardinality=10
|
04:AGGREGATE [FINALIZE]
|  output: count:merge(int_col), count:merge(bigint_col)
|  group by: string_col
|  row-size=29B cardinality=10
|
03:EXCHANGE [HASH(string_col)]
|
01:AGGREGATE [STREAMING]
|  output: count(int_col), count(bigint_col)
|  group by: string_col
|  row-size=29B cardinality=30
|
00:SCAN HDFS [functional.alltypes]
   partition predicates: `year` = 2009
   HDFS partitions=12/24 files=12 size=238.68KB
