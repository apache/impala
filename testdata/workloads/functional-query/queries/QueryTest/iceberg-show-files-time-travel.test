# Test SHOW FILES with time-travel AND partition filter (timestamp)
SHOW FILES IN iceberg_timetravel_partitioned_showfiles
FOR SYSTEM_TIME AS OF '$FIRST_PART_TIMESTAMP'
PARTITION (id = 1);
---- RESULTS
row_regex:'$NAMENODE/test-warehouse/$DATABASE.db/iceberg_timetravel_partitioned_showfiles/data/id=1/.*_data.*.parq','.*','','$ERASURECODE_POLICY'
