---- QUERY
# Test SHOW FILES with time-travel at first snapshot (should only show partition id=1, first insert)
SHOW FILES IN iceberg_timetravel_partitioned_showfiles
FOR SYSTEM_VERSION AS OF $FIRST_PART_SNAPSHOT;
---- RESULTS
row_regex:'$NAMENODE/test-warehouse/$DATABASE.db/iceberg_timetravel_partitioned_showfiles/data/id=1/.*_data.*.parq','.*','','$ERASURECODE_POLICY'
---- TYPES
STRING, STRING, STRING, STRING
====
---- QUERY
# Test SHOW FILES with time-travel AND partition filter (version)
SHOW FILES IN iceberg_timetravel_partitioned_showfiles
FOR SYSTEM_VERSION AS OF $SECOND_PART_SNAPSHOT
PARTITION (id = 2);
---- RESULTS
row_regex:'$NAMENODE/test-warehouse/$DATABASE.db/iceberg_timetravel_partitioned_showfiles/data/id=2/.*_data.*.parq','.*','','$ERASURECODE_POLICY'
---- TYPES
STRING, STRING, STRING, STRING
