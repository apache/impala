STRING, STRING, STRING, STRING
====
---- QUERY
# Verify SELECT time-travel and SHOW FILES time-travel are consistent
# Count rows from first snapshot using SELECT
SELECT COUNT(*) FROM iceberg_timetravel_showfiles FOR SYSTEM_VERSION AS OF $FIRST_SNAPSHOT;
---- RESULTS
1
---- TYPES
BIGINT
====
---- QUERY
# Verify SELECT with timestamp
SELECT COUNT(*) FROM iceberg_timetravel_showfiles FOR SYSTEM_TIME AS OF '$FIRST_TIMESTAMP';
---- RESULTS
1
---- TYPES
BIGINT
====
---- QUERY
# Negative test: Invalid (non-existent) snapshot ID
SHOW FILES IN iceberg_timetravel_showfiles FOR SYSTEM_VERSION AS OF 999999999999999;
---- CATCH
IllegalArgumentException: Cannot find snapshot with ID 999999999999999
====
---- QUERY
# Negative test: Timestamp too far in the past (before any snapshots)
SHOW FILES IN iceberg_timetravel_showfiles FOR SYSTEM_TIME AS OF '2000-01-01 00:00:00';
---- CATCH
IllegalArgumentException: Cannot find a snapshot older than 2000-01-01 00:00:00
====
---- QUERY
# Negative test: Invalid timestamp format
SHOW FILES IN iceberg_timetravel_showfiles FOR SYSTEM_TIME AS OF 'invalid-timestamp';
---- CATCH
AnalysisException: Invalid TIMESTAMP expression
====
---- QUERY
# Negative test: Decimal value for SYSTEM_VERSION (analysis error - not an integer type)
SHOW FILES IN iceberg_timetravel_showfiles FOR SYSTEM_VERSION AS OF 123.45;
---- CATCH
AnalysisException: FOR SYSTEM_VERSION AS OF <expression> must be an integer type
