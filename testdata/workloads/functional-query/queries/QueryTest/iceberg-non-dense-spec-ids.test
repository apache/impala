====
---- QUERY
# The position delete file must be written with spec 1, i.e. into the partition of
# the deleted row.
SHOW FILES IN ice_nondense;
---- RESULTS: VERIFY_IS_SUBSET
row_regex:'$NAMENODE/test-warehouse/$DATABASE.db/ice_nondense/data/region=SA/delete-.*parq','.*B','','.*'
---- TYPES
STRING, STRING, STRING, STRING
====
---- QUERY
# Going back to identity(region) reuses spec id 1, so the specs are [1, 2] and the
# default spec is 1.
ALTER TABLE ice_nondense SET PARTITION SPEC (region);
SHOW CREATE TABLE ice_nondense;
---- RESULTS
row_regex:.*PARTITIONED BY SPEC\\n\(\\n  region\\n\).*
---- TYPES
STRING
