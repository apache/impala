---- QUERY
# New partition spec. It gets id 2, so the specs are [1, 2] and the default spec is 2.
ALTER TABLE ice_nondense SET PARTITION SPEC (id);
SHOW CREATE TABLE ice_nondense;
---- RESULTS
row_regex:.*PARTITIONED BY SPEC\\n\(\\n  id\\n\).*
---- TYPES
STRING
