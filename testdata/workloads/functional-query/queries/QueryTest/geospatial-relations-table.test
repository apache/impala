====
---- QUERY
-- equals: same-type pairs (all true)
SELECT
  st_Equals(point1, point2),
  st_Equals(linestring1, linestring2),
  st_Equals(polygon1, polygon2),
  st_Equals(multipoint1, multipoint2),
  st_Equals(multilinestring1, multilinestring2),
  st_Equals(multipolygon1, multipolygon2)
FROM functional.geom_relations WHERE id = 'equals';
---- TYPES
BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN
---- RESULTS
true,true,true,true,true,true
====
---- QUERY
-- equals: point1 vs single-component multi types (same point set)
SELECT
  st_Equals(point1, multipoint2),
  st_Equals(multipoint1, point2)
FROM functional.geom_relations WHERE id = 'equals';
---- TYPES
BOOLEAN,BOOLEAN
---- RESULTS
true,true
====
---- QUERY
-- equals: linestring1 vs multilinestring (same point set)
SELECT
  st_Equals(linestring1, multilinestring2),
  st_Equals(multilinestring1, linestring2)
FROM functional.geom_relations WHERE id = 'equals';
---- TYPES
BOOLEAN,BOOLEAN
---- RESULTS
true,true
====
---- QUERY
-- equals: polygon1 vs multipolygon (same point set)
SELECT
  st_Equals(polygon1, multipolygon2),
  st_Equals(multipolygon1, polygon2)
FROM functional.geom_relations WHERE id = 'equals';
---- TYPES
BOOLEAN,BOOLEAN
---- RESULTS
true,true
====
---- QUERY
-- equals: cross-dimension pairs (all false)
SELECT
  st_Equals(point1, linestring2),
  st_Equals(point1, polygon2),
  st_Equals(linestring1, polygon2),
  st_Equals(linestring1, multipoint2),
  st_Equals(polygon1, point2),
  st_Equals(polygon1, multilinestring2)
FROM functional.geom_relations WHERE id = 'equals';
---- TYPES
BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN
---- RESULTS
false,false,false,false,false,false
====
---- QUERY
-- disjoint_near: all non-NULL cross-type pairs are disjoint (st_Intersects=false)
SELECT
  st_Intersects(linestring1, polygon2),
  st_Intersects(linestring1, multipoint2),
  st_Intersects(linestring1, multilinestring2),
  st_Intersects(linestring1, multipolygon2),
  st_Intersects(polygon1, linestring2),
  st_Intersects(polygon1, multipoint2)
FROM functional.geom_relations WHERE id = 'disjoint_near';
---- TYPES
BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN
---- RESULTS
false,false,false,false,false,false
====
---- QUERY
-- disjoint_near: more cross-type pairs
SELECT
  st_Intersects(polygon1, multilinestring2),
  st_Intersects(polygon1, multipolygon2),
  st_Intersects(multipoint1, linestring2),
  st_Intersects(multipoint1, polygon2),
  st_Intersects(multipoint1, multipoint2),
  st_Intersects(multipoint1, multipolygon2)
FROM functional.geom_relations WHERE id = 'disjoint_near';
---- TYPES
BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN
---- RESULTS
false,false,false,false,false,false
====
---- QUERY
