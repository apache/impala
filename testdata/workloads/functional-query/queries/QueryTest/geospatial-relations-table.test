  st_Intersects(multipolygon2, polygon1),
  st_Intersects(multipolygon2, multilinestring1),
  st_Intersects(multipolygon2, multipolygon1)
FROM functional.geom_relations WHERE id = 'disjoint_far';
---- TYPES
BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN
---- RESULTS
false,false,false,false,false,false
====
---- QUERY
-- constant LHS: polygon literal contains table column geometries (exercises PrepareLhs)
SELECT
  st_Contains(st_GeomFromText('POLYGON((0 0, 10 0, 10 10, 0 10, 0 0))'),
              point2),
  st_Contains(st_GeomFromText('POLYGON((0 0, 10 0, 10 10, 0 10, 0 0))'),
              linestring2),
  st_Contains(st_GeomFromText('POLYGON((0 0, 10 0, 10 10, 0 10, 0 0))'),
              polygon2),
  st_Contains(st_GeomFromText('POLYGON((0 0, 10 0, 10 10, 0 10, 0 0))'),
              multipoint2),
  st_Contains(st_GeomFromText('POLYGON((0 0, 10 0, 10 10, 0 10, 0 0))'),
              multilinestring2),
  st_Contains(st_GeomFromText('POLYGON((0 0, 10 0, 10 10, 0 10, 0 0))'),
              multipolygon2)
FROM functional.geom_relations WHERE id = 'contains';
---- TYPES
BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN
---- RESULTS
true,true,true,true,true,true
====
---- QUERY
-- constant RHS: table column geometries contain point literal (exercises PrepareRhs)
SELECT
  st_Contains(point1,
              st_GeomFromText('POINT(5 5)')),
  st_Contains(linestring1,
              st_GeomFromText('POINT(5 5)')),
  st_Contains(polygon1,
              st_GeomFromText('POINT(5 5)')),
  st_Contains(multipoint1,
              st_GeomFromText('POINT(5 5)')),
  st_Contains(multilinestring1,
              st_GeomFromText('POINT(5 5)')),
  st_Contains(multipolygon1,
              st_GeomFromText('POINT(5 5)'))
FROM functional.geom_relations WHERE id = 'contains';
---- TYPES
BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN
---- RESULTS
true,true,true,true,true,true
====
---- QUERY
-- constant RHS: table column geometries contain multipoint literal
