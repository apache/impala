  st_Intersects(linestring1, linestring2),
  st_Intersects(polygon1, polygon2),
  st_Intersects(multipoint1, multipoint2),
  st_Intersects(multilinestring1, multilinestring2),
  st_Intersects(multipolygon1, multipolygon2)
FROM functional.geom_relations WHERE id = 'disjoint_near';
