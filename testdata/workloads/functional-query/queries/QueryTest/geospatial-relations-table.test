  st_Contains(polygon1,
              st_GeomFromText('MULTIPOINT((5 5))')),
  st_Contains(multipoint1,
              st_GeomFromText('MULTIPOINT((5 5))')),
  st_Contains(multipolygon1,
              st_GeomFromText('MULTIPOINT((5 5))'))
FROM functional.geom_relations WHERE id = 'contains';
