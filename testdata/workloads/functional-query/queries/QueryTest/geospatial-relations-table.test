---- QUERY
-- constant LHS false case: disjoint polygon does not intersect table geometries
SELECT
  st_Intersects(st_GeomFromText('POLYGON((50 50, 51 50, 51 51, 50 51, 50 50))'),
                point2),
  st_Intersects(st_GeomFromText('POLYGON((50 50, 51 50, 51 51, 50 51, 50 50))'),
                linestring2),
  st_Intersects(st_GeomFromText('POLYGON((50 50, 51 50, 51 51, 50 51, 50 50))'),
                polygon2),
  st_Intersects(st_GeomFromText('POLYGON((50 50, 51 50, 51 51, 50 51, 50 50))'),
                multipolygon2)
FROM functional.geom_relations WHERE id = 'contains';
---- TYPES
BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN
---- RESULTS
false,false,false,false
====
---- QUERY
-- constant RHS false case: table geometries do not contain distant point
SELECT
  st_Contains(polygon1,
              st_GeomFromText('POINT(50 50)')),
  st_Contains(multipolygon1,
              st_GeomFromText('POINT(50 50)'))
FROM functional.geom_relations WHERE id = 'contains';
---- TYPES
BOOLEAN,BOOLEAN
---- RESULTS
false,false
