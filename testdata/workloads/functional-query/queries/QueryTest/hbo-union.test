====
---- QUERY
# EXPLAIN the same query but using UNION ALL. The UnionNode should still hit HBO stats.
EXPLAIN select id from functional.alltypes
where year = 2009 and int_col = 1 and string_col != 'test_union'
union all
select id from functional.alltypestiny
where int_col = 0 and string_col != 'test_union'
