====
---- QUERY
# Change the alltypes operand (the 2nd operand after sorted by HBO key string) to select
# 0 partitions thus has a different numInputRows. The HBO key strings of UnionNode matches
# in IGNORE_PARTITION_CONSTANTS strategy but the historical runs matching should
# distinguish them based on numInputRows.
EXPLAIN select id from functional.alltypes
where year = 2019 and int_col = 1 and string_col != 'test_union'
union all
select id from functional.alltypestiny
where int_col = 0 and string_col != 'test_union'
---- PLAN
