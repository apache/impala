---- QUERY
# UPDATE and DELETE have no KUDU-partitioned exchange, so the writer runs in the Kudu
# scan fragment (one instance per host with a tablet) and neither the tablet count nor
# MAX_FS_WRITERS applies.
SET MT_DOP=10;
SET MAX_FS_WRITERS=1;
update hash3 set int_col = -1 where id > 5
---- RUNTIME_PROFILE
NumModifiedRows: 7294
NumRowErrors: 0
row_regex: .*F\d+:KUDU WRITER\s+3\s+3\s+.*
====
---- QUERY
select count(*) from hash3 where int_col = -1
---- RESULTS
7294
---- TYPES
BIGINT
====
