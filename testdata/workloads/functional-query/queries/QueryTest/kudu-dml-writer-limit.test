====
---- QUERY
# INSERT/UPSERT into a partitioned Kudu table shuffle rows by Kudu partition, so the
# number of KUDU WRITER instances is capped at the table's tablet count (and at
# MAX_FS_WRITERS if that is lower), even though MT_DOP would otherwise scale the writer
# fragment past it. The KUDU WRITER row of the exec summary in the profile has the
# columns "#Hosts #Inst".
create table hash3 (id int primary key, int_col int)
  partition by hash (id) partitions 3 stored as kudu
---- RESULTS
'Table has been created.'
====
---- QUERY
create table range2 (id int primary key, int_col int)
  partition by range (id) (partition values < 3650, partition 3650 <= values)
  stored as kudu
---- RESULTS
'Table has been created.'
====
---- QUERY
create table hash_range6 (id int, string_col string, int_col int,
  primary key (id, string_col))
  partition by hash (id) partitions 3, range (string_col)
  (partition values < '5', partition '5' <= values)
  stored as kudu
---- RESULTS
'Table has been created.'
====
---- QUERY
# 3 hash buckets -> 3 tablets.
SET MT_DOP=10;
SET MAX_FS_WRITERS=0;
insert into hash3 select id, int_col from functional_parquet.alltypes
---- RUNTIME_PROFILE
NumModifiedRows: 7300
NumRowErrors: 0
row_regex: .*F\d+:KUDU WRITER\s+\d+\s+3\s+.*
====
---- QUERY
select count(*) from hash3
---- RESULTS
7300
---- TYPES
BIGINT
====
