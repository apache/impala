---- QUERY
# The target table of a CTAS does not exist in Kudu at planning time, so its tablet
# count is estimated from the PARTITION BY clause of the statement.
SET MT_DOP=10;
SET MAX_FS_WRITERS=0;
create table ctas_hash3 primary key (id) partition by hash (id) partitions 3
  stored as kudu as select id, int_col from functional_parquet.alltypes
---- RUNTIME_PROFILE
NumModifiedRows: 7300
NumRowErrors: 0
row_regex: .*F\d+:KUDU WRITER\s+\d+\s+3\s+.*
====
---- QUERY
select count(*) from ctas_hash3
---- RESULTS
7300
---- TYPES
BIGINT
====
