---- QUERY
# As with HDFS tables, COMPUTE_PROCESSING_COST estimates the writer count from the input
# size, which is small enough here for a single writer.
create table cost_hash_range6 (id int, string_col string, int_col int,
  primary key (id, string_col))
  partition by hash (id) partitions 3, range (string_col)
  (partition values < '5', partition '5' <= values)
  stored as kudu
---- RESULTS
'Table has been created.'
====
---- QUERY
SET MT_DOP=0;
SET MAX_FS_WRITERS=0;
SET COMPUTE_PROCESSING_COST=true;
SET PROCESSING_COST_MIN_THREADS=10;
SET MAX_FRAGMENT_INSTANCES_PER_NODE=10;
insert into cost_hash_range6
select id, string_col, int_col from functional_parquet.alltypes
---- RUNTIME_PROFILE
NumModifiedRows: 7300
NumRowErrors: 0
row_regex: .*F\d+:KUDU WRITER\s+1\s+1\s+.*
