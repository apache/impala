---- QUERY
# MAX_FS_WRITERS overrides a noshuffle hint, as for HDFS tables.
SET MT_DOP=10;
SET MAX_FS_WRITERS=2;
upsert into hint_hash3 /* +noshuffle */
select id, int_col from functional_parquet.alltypes
---- RUNTIME_PROFILE
NumModifiedRows: 7300
NumRowErrors: 0
row_regex: .*F\d+:KUDU WRITER\s+\d+\s+2\s+.*
