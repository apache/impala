---- QUERY
# Per-range hash schemas: 3 (table-wide) + 2 + 4 = 9 tablets.
SET MT_DOP=10;
SET MAX_FS_WRITERS=0;
create table ctas_custom_hash9 primary key (id, string_col)
  partition by hash (id) partitions 3, range (string_col)
  (
    partition values < '3'
    , partition '3' <= values < '6' hash partitions 2
    , partition '6' <= values hash (id) partitions 4
  )
  stored as kudu as select id, string_col, int_col from functional_parquet.alltypes
---- RUNTIME_PROFILE
NumModifiedRows: 7300
NumRowErrors: 0
row_regex: .*F\d+:KUDU WRITER\s+\d+\s+9\s+.*
====
---- QUERY
select count(*) from ctas_custom_hash9
---- RESULTS
7300
---- TYPES
BIGINT
====
---- QUERY
# A shuffle hint still adds the KUDU-partitioned exchange, so the cap applies.
create table hint_hash3 (id int primary key, int_col int)
  partition by hash (id) partitions 3 stored as kudu
---- RESULTS
'Table has been created.'
====
---- QUERY
SET MT_DOP=10;
SET MAX_FS_WRITERS=0;
insert into hint_hash3 /* +shuffle */ select id, int_col from functional_parquet.alltypes
---- RUNTIME_PROFILE
NumModifiedRows: 7300
NumRowErrors: 0
row_regex: .*F\d+:KUDU WRITER\s+\d+\s+3\s+.*
