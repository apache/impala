====
---- QUERY
# IMPALA-15421: The residuals of different files can differ only in their literal values,
# e.g. 'id != 11' and 'id != 21' below. Predicate subsetting must keep both of them.
create table ice_trunc (id int) partitioned by spec (truncate(10, id))
stored as iceberg;
insert into ice_trunc values (11), (12), (21), (22);
select id from ice_trunc where id != 11 and id != 21;
---- RESULTS
12
22
---- TYPES
INT
====
---- QUERY
select id from ice_trunc where id not in (11, 21);
---- RESULTS
12
22
---- TYPES
INT
====
---- QUERY
create table ice_day (ts timestamp, s string) partitioned by spec (day(ts))
stored as iceberg;
insert into ice_day values
  ('2024-01-01 00:00:00', 'a'), ('2024-01-01 01:00:00', 'b'),
  ('2024-02-02 00:00:00', 'c'), ('2024-02-02 01:00:00', 'd');
select s from ice_day
where ts != '2024-01-01 00:00:00' and ts != '2024-02-02 00:00:00';
---- RESULTS
'b'
'd'
---- TYPES
STRING
====
---- QUERY
# The residuals of the files of both partitions are 'i > 5', but they come from different
# conjuncts, so both conjuncts must be kept.
create table ice_same_residual (p int, i int) partitioned by spec (p) stored as iceberg;
insert into ice_same_residual values (1, 1), (1, 10), (2, 1), (2, 10);
select p, i from ice_same_residual where (p = 1 or i > 5) and (p = 2 or i > 5);
---- RESULTS
1,10
2,10
---- TYPES
INT,INT
====
