# Verify Final filter table:
#  ID  Src. Node  Tgt. Node(s)  Eff. Tgt. Node(s)  Target type  ...
# -----------------------------------------------------------------
#   4          7             4                  N        LOCAL  ...
#   3          8             3                  N        LOCAL  ...
#   2          8             3                  3        LOCAL  ...
#   0         10             4                  N        LOCAL  ...
row_regex: 4\s+7\s+4\s+N\s+LOCAL
row_regex: 3\s+8\s+3\s+[3N]\s+LOCAL
