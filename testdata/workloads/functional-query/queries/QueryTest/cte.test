---- TYPES
STRING, STRING
====
---- QUERY
CREATE TABLE emps (empid INT, deptno INT, name STRING, salary DECIMAL(8, 2)) STORED AS TEXTFILE;
---- RESULTS
'Table has been created.'
====
---- QUERY
INSERT INTO emps VALUES
    (1, 1, "Phil", 45000.0), (2, 1, "Maggie", 55000.0), (3, 2, "Alice", 120000.0);
---- RESULTS
====
---- QUERY
EXPLAIN SELECT name FROM emps e WHERE salary > 50000
UNION SELECT name FROM emps e WHERE salary > 50000;
---- RESULTS: VERIFY_IS_EQUAL
