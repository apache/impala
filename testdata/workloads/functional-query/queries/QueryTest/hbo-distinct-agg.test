====
---- QUERY
# EXPLAIN the same query that has been executed
EXPLAIN select int_col, count(distinct string_col), count(distinct bigint_col)
  from functional.alltypes where year = 2009 and string_col != 'test_distinct_agg'
  group by int_col
---- PLAN
PLAN-ROOT SINK
|
08:EXCHANGE [UNPARTITIONED]
|
03:AGGREGATE [FINALIZE]
|  output: aggif(valid_tid(2,4) = 2, count(string_col)), aggif(valid_tid(2,4) = 4, count(bigint_col))
|  group by: CASE valid_tid(2,4) WHEN 2 THEN int_col WHEN 4 THEN int_col END
|  row-size=20B cardinality=10 (from HBO)
|
07:AGGREGATE [FINALIZE]
|  Class 0
|    output: count:merge(string_col)
|    group by: int_col
|  Class 1
|    output: count:merge(bigint_col)
|    group by: int_col
|  row-size=24B cardinality=20 (from HBO)
|
06:EXCHANGE [HASH(CASE valid_tid(2,4) WHEN 2 THEN murmur_hash(int_col) WHEN 4 THEN murmur_hash(int_col) END)]
|
02:AGGREGATE [STREAMING]
|  Class 0
|    output: count(string_col)
|    group by: int_col
|  Class 1
|    output: count(bigint_col)
|    group by: int_col
|  row-size=24B cardinality=20 (from HBO)
|
05:AGGREGATE
|  Class 0
|    group by: int_col, string_col
|  Class 1
|    group by: int_col, bigint_col
|  row-size=29B cardinality=20 (from HBO)
|
04:EXCHANGE [HASH(CASE valid_tid(1,3) WHEN 1 THEN murmur_hash(int_col) WHEN 3 THEN murmur_hash(int_col) END,CASE valid_tid(1,3) WHEN 1 THEN murmur_hash(string_col) WHEN 3 THEN murmur_hash(bigint_col) END)]
|
01:AGGREGATE [STREAMING]
|  Class 0
|    group by: int_col, string_col
|  Class 1
|    group by: int_col, bigint_col
|  row-size=29B cardinality=60 (from HBO)
|
00:SCAN HDFS [functional.alltypes]
   partition predicates: `year` = 2009
   HDFS partitions=12/24 files=12 size=238.68KB
   predicates: string_col != 'test_distinct_agg'
   row-size=25B cardinality=3.65K (from HBO)
