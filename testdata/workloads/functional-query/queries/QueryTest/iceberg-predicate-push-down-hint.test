====
---- QUERY
# File not filtered during planning as there is no predicate on partition column.
create table t (a int, b int, c int) stored as iceberg;
insert into t values (1, 1, 1);
select count(*) from t where a = 0;
---- TYPES
BIGINT
---- RESULTS
0
---- RUNTIME_PROFILE
aggregation(SUM, NumRowGroups): 1
aggregation(SUM, NumStatsFilteredRowGroups): 1
====
---- QUERY
# File filtered during planning if there is a predicate on a column in hint.
alter table t set tblproperties ("impala.iceberg.push_down_hint"="a,b");
select count(*) from t where a = 0;
---- TYPES
BIGINT
---- RESULTS
0
---- RUNTIME_PROFILE
aggregation(SUM, NumRowGroups): 0
====
---- QUERY
# File not filtered during planning if there are predicates only on columns not in hint.
select count(*) from t where c = 0;
---- TYPES
BIGINT
---- RESULTS
0
---- RUNTIME_PROFILE
aggregation(SUM, NumRowGroups): 1
aggregation(SUM, NumStatsFilteredRowGroups): 1
====
---- QUERY
# Timestamp literals with nanoseconds are not pushed down, because they would be rounded
# to microseconds for Iceberg.
create table ts_tbl (ts timestamp) stored as iceberg
tblproperties ('impala.iceberg.push_down_hint'='ts');
insert into ts_tbl values ('2024-01-01 00:00:00');
select count(*) from ts_tbl where ts < '2024-01-01 00:00:00.0000004';
---- TYPES
BIGINT
---- RESULTS
1
====
---- QUERY
select count(*) from ts_tbl where ts > '2023-12-31 23:59:59.9999996';
---- TYPES
BIGINT
---- RESULTS
1
====
---- QUERY
select count(*) from ts_tbl where ts != '2024-01-01 00:00:00.0000004';
---- TYPES
BIGINT
---- RESULTS
1
====
---- QUERY
# The same for partition transforms.
create table ts_part_tbl (ts timestamp) partitioned by spec (day(ts)) stored as iceberg;
insert into ts_part_tbl values ('2024-01-01 00:00:00');
select count(*) from ts_part_tbl
where ts > '2023-01-01' and ts < '2024-01-01 00:00:00.0000004';
---- TYPES
BIGINT
---- RESULTS
1
====
---- QUERY
# Literals with microsecond precision are still pushed down.
select count(*) from ts_tbl where ts > '2024-01-01 00:00:00.000001';
---- TYPES
BIGINT
---- RESULTS
0
---- RUNTIME_PROFILE
skipped-data-files: 1
