# =============================================================================
# Tests for Avro schema literal errors caught in CatalogOpExecutor.
# These cases were previously caught at analysis time but are now deferred to
# DDL execution so that avro.schema.url authorization can be evaluated first.
# =============================================================================
====
---- QUERY
# CREATE TABLE with a schema literal where the decimal field has no precision.
# Precision is required by the Avro spec; the error is caught in CatalogOpExecutor.
CREATE TABLE avro_decimal_no_precision STORED AS AVRO TBLPROPERTIES (
  'avro.schema.url'='/test-warehouse/bad_avro_schemas/no_precision.json')
---- CATCH
No 'precision' property specified for 'decimal' logicalType
====
---- QUERY
# CREATE TABLE with a schema literal where the decimal precision is negative.
CREATE TABLE avro_decimal_neg_precision STORED AS AVRO TBLPROPERTIES (
  'avro.schema.url'='/test-warehouse/bad_avro_schemas/neg_precision.json')
---- CATCH
Invalid decimal 'precision' property value
====
---- QUERY
# CREATE TABLE with a schema literal where the decimal scale is negative.
CREATE TABLE avro_decimal_neg_scale STORED AS AVRO TBLPROPERTIES (
  'avro.schema.url'='/test-warehouse/bad_avro_schemas/neg_scale.json')
---- CATCH
Invalid decimal 'scale' property value
====
---- QUERY
# CREATE TABLE with a schema literal containing a non-nullable union, which Impala
# does not support. Error is caught in CatalogOpExecutor.
CREATE TABLE avro_create_union_type STORED AS AVRO TBLPROPERTIES (
  'avro.schema.url'='/test-warehouse/bad_avro_schemas/union.json')
---- CATCH
Unsupported type 'union' of column 'union1'
====
---- QUERY
# CREATE TABLE with a syntactically invalid JSON schema literal.
# Error is caught in CatalogOpExecutor.
CREATE TABLE avro_create_bad_json STORED AS AVRO TBLPROPERTIES (
  'avro.schema.url'='/test-warehouse/bad_avro_schemas/bad_json.json')
---- CATCH
Unexpected close marker ']': expected '}'
====
---- QUERY
# Set up a table to use for ALTER TABLE literal-schema error tests.
CREATE TABLE avro_alter_schema_errors (s string) STORED AS AVRO
====
---- QUERY
# ALTER TABLE with a schema literal containing a non-nullable union type.
ALTER TABLE avro_alter_schema_errors SET TBLPROPERTIES (
  'avro.schema.url'='/test-warehouse/bad_avro_schemas/union.json')
---- CATCH
Unsupported type 'union' of column 'union1'
====
---- QUERY
# ALTER TABLE with a syntactically invalid JSON schema literal.
ALTER TABLE avro_alter_schema_errors SET TBLPROPERTIES (
  'avro.schema.url'='/test-warehouse/bad_avro_schemas/bad_json.json')
---- CATCH
Unexpected close marker ']': expected '}'
====
---- QUERY
# ALTER TABLE with a schema literal that has no "type" field.
ALTER TABLE avro_alter_schema_errors SET TBLPROPERTIES (
  'avro.schema.url'='/test-warehouse/bad_avro_schemas/no_type.json')
---- CATCH
No type:
====
---- QUERY
# ALTER TABLE with a schema literal record that has no "name" field.
ALTER TABLE avro_alter_schema_errors SET TBLPROPERTIES (
  'avro.schema.url'='/test-warehouse/bad_avro_schemas/no_name.json')
---- CATCH
No name in schema:
====
