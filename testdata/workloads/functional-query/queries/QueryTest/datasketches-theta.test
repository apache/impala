====
---- QUERY
# Write sketches to a table as binary and get an estimate from the written sketch.
create table sketch_store
    (year int, month int, date_sketch binary, float_sketch binary)
stored as parquet;
insert into sketch_store
    select
        year,
        month,
        ds_theta_sketch(date_string_col),
        ds_theta_sketch(float_col)
    from functional_parquet.alltypessmall
    group by year, month;
select
    year,
    month,
    ds_theta_estimate(date_sketch),
    ds_theta_estimate(float_sketch)
from sketch_store order by month;
---- RESULTS
2009,1,3,10
2009,2,3,10
2009,3,3,10
2009,4,3,10
---- TYPES
INT,INT,BIGINT,BIGINT
