    ds_theta_sketch_and_estimate(float_col),
    ds_theta_sketch_and_estimate(double_col),
    ds_theta_sketch_and_estimate(string_col)
from functional_parquet.alltypessmall;
---- RESULTS
10,10,10,10,10,10
---- TYPES
BIGINT,BIGINT,BIGINT,BIGINT,BIGINT,BIGINT
