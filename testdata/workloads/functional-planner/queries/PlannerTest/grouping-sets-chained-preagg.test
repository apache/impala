# ROLLUP chains the classes of the streaming preaggregation. Each class after the
# first merges the output of the previous class.
select l_returnflag, l_linestatus, l_shipmode, count(*), min(l_comment),
  avg(l_discount), ndv(l_partkey)
from tpch.lineitem
group by rollup(l_returnflag, l_linestatus, l_shipmode)
