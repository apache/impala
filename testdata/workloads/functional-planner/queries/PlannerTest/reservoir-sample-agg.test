# COUNT(DISTINCT) makes the first phase group by the distinct columns too, here into
# about one row per group, so appx_median() is updated in many small groups and merged
# into the few groups of the second phase.
select l_returnflag, l_linestatus, count(distinct l_orderkey, l_linenumber),
  count(*), appx_median(l_quantity),
  appx_median(case when l_discount > 0 then l_quantity end),
  appx_median(l_extendedprice / l_quantity),
  appx_median(case when l_discount > 0 then l_extendedprice / l_quantity end)
from lineitem
group by l_returnflag, l_linestatus
---- DISTRIBUTEDPLAN
