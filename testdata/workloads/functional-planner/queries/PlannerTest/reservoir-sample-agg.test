# Few groups with many rows each: the sample array grows to its maximum capacity. The
# rounded DECIMAL sample arrays use twice the memory of BIGINT arrays.
select l_shipmode, appx_median(l_extendedprice), appx_median(l_orderkey)
from lineitem group by l_shipmode
