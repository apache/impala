# IMPALA-13052: sample(), appx_median() and histogram() keep a reservoir sample of up
# to 20000 values per group outside the tuple. Without grouping, each instance here
# gets more than 20000 rows and fills the reservoir, and so does the merge.
select sample(l_orderkey), appx_median(l_orderkey), histogram(l_orderkey)
from lineitem
