# Without stats the number of groups is unknown and the aggregation gets the default
# estimate, to which nothing is added for the reservoir samples. The sizes of these
# Parquet files differ between data loads, so the no-stats cases turn off the row
# estimate from the file sizes and split every file into three scan ranges.
select appx_median(int_col) from functional_parquet.alltypes group by bigint_col
