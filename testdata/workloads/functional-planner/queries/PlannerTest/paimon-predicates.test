select * from functional_parquet.paimon_partitioned where userid=1 and movieid=3;
---- PLAN
PLAN-ROOT SINK
|
00:SCAN PAIMON [functional_parquet.paimon_partitioned]
   predicates: movieid = 3
   paimon predicates: movieid = 3, userid = 1
   paimon partition predicates: userid = 1
   row-size=20B cardinality=1
====
select * from functional_parquet.paimon_partitioned where userid<3 and movieid=3;
---- PLAN
PLAN-ROOT SINK
|
00:SCAN PAIMON [functional_parquet.paimon_partitioned]
    predicates: movieid = 3
    paimon predicates: movieid = 3, userid < 3
    paimon partition predicates: userid < 3
    row-size=20B cardinality=1
====
select * from functional_parquet.paimon_partitioned where userid=1 and rating>3;
