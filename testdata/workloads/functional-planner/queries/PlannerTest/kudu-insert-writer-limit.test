# UPDATE of a Kudu table with a broadcast join against another table. There is still no
# exchange to the writer, so the writer stays in the fragment that produces the rows.
update a set a.int_col = b.int_col
from functional_parquet.alltypes b join /* +broadcast */ functional_kudu.alltypes a
on a.id = b.id;
