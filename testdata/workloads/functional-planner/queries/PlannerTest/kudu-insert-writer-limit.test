# CTAS of a large input with COMPUTE_PROCESSING_COST. The size-based writer estimate
# exceeds the tablet count (9) estimated from the statement's partitioning.
create table kudu_ctas primary key (id, string_col)
partition by hash (id) partitions 3, range (string_col)
(
  partition values < '3'
  , partition '3' <= values < '6' hash partitions 2
  , partition '6' <= values hash (id) partitions 4
)
stored as kudu as
select a.id, a.string_col
from functional.alltypes a, functional.alltypes b, functional.alltypes c;
---- QUERYOPTIONS
compute_processing_cost=true
processing_cost_min_threads=10
max_fragment_instances_per_node=10
---- DISTRIBUTEDPLAN
F03:PLAN FRAGMENT [KUDU(KuduPartition(a.id, a.string_col))] hosts=3 instances=9
|  Per-Instance Resources: mem-estimate=158.68MB mem-reservation=4.00MB thread-reservation=1
regex:\|  max-parallelism=9 segment-costs=\[\d{13}\] cpu-comparison-result=33 \[max\(33 \(self\) vs 12 \(sum children\)\)\]
INSERT INTO KUDU [default.kudu_ctas]
|  output exprs: id, string_col
regex:\|  mem-estimate= mem-reservation= thread-reservation= cost=\d{12}
|
