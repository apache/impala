====
---- QUERY
# Each query compares grouping sets query 'r' with the equivalent GROUP BY queries 'u'
# and returns the number of distinct rows and of rows that aren't in both.
#
# Rollup with fixed-size and variable-length intermediates.
with r as (
  select l_returnflag f, l_linestatus s, l_shipmode m, grouping_id() gid,
    count(*) c, sum(l_extendedprice) sp, avg(l_discount) ad, min(l_comment) mn,
    max(l_shipinstruct) mx, ndv(l_partkey) nd, length(group_concat(l_linestatus, '')) gc
  from lineitem
  group by rollup(l_returnflag, l_linestatus, l_shipmode)),
u as (
  select l_returnflag f, l_linestatus s, l_shipmode m, 0 gid,
    count(*) c, sum(l_extendedprice) sp, avg(l_discount) ad, min(l_comment) mn,
    max(l_shipinstruct) mx, ndv(l_partkey) nd, length(group_concat(l_linestatus, '')) gc
  from lineitem group by 1, 2, 3
  union all
  select l_returnflag, l_linestatus, null, 1,
    count(*), sum(l_extendedprice), avg(l_discount), min(l_comment),
    max(l_shipinstruct), ndv(l_partkey), length(group_concat(l_linestatus, ''))
  from lineitem group by 1, 2
  union all
  select l_returnflag, null, null, 3,
    count(*), sum(l_extendedprice), avg(l_discount), min(l_comment),
    max(l_shipinstruct), ndv(l_partkey), length(group_concat(l_linestatus, ''))
  from lineitem group by 1
  union all
  select null, null, null, 7,
    count(*), sum(l_extendedprice), avg(l_discount), min(l_comment),
    max(l_shipinstruct), ndv(l_partkey), length(group_concat(l_linestatus, ''))
  from lineitem)
select count(*), sum(if(n = 2, 0, 1)) from (
  select count(*) n from (select * from r union all select * from u) t
  group by f, s, m, gid, c, sp, ad, mn, mx, nd, gc) v
---- RESULTS
36,0
---- TYPES
BIGINT,BIGINT
====
---- QUERY
# Almost unique keys, so the first class passes through most rows, with string
# intermediates.
with r as (
  select l_orderkey o, l_linenumber l, grouping_id() gid, count(*) c,
    sum(l_quantity) sq, avg(l_tax) atx, min(l_comment) mn, max(l_shipmode) mx
  from lineitem
  group by rollup(l_orderkey, l_linenumber)),
u as (
  select l_orderkey o, l_linenumber l, 0 gid, count(*) c,
    sum(l_quantity) sq, avg(l_tax) atx, min(l_comment) mn, max(l_shipmode) mx
  from lineitem group by 1, 2
  union all
  select l_orderkey, null, 1, count(*),
    sum(l_quantity), avg(l_tax), min(l_comment), max(l_shipmode)
  from lineitem group by 1
  union all
  select null, null, 3, count(*),
    sum(l_quantity), avg(l_tax), min(l_comment), max(l_shipmode)
  from lineitem)
select count(*), sum(if(n = 2, 0, 1)) from (
  select count(*) n from (select * from r union all select * from u) t
  group by o, l, gid, c, sq, atx, mn, mx) v
