---- QUERY
# Rollup over string keys that have NULL values, with grouping().
with r as (
  select n_name nn, if(c_mktsegment = 'BUILDING', null, c_mktsegment) seg,
    grouping_id() gid, grouping(n_name) gn, count(*) c, sum(c_acctbal) sb,
    min(c_phone) mn, max(c_name) mx
  from customer join nation on c_nationkey = n_nationkey
  group by rollup(n_name, if(c_mktsegment = 'BUILDING', null, c_mktsegment))),
u as (
  select n_name nn, if(c_mktsegment = 'BUILDING', null, c_mktsegment) seg, 0 gid,
    0 gn, count(*) c, sum(c_acctbal) sb, min(c_phone) mn, max(c_name) mx
  from customer join nation on c_nationkey = n_nationkey
  group by 1, 2
  union all
  select n_name, null, 1, 0, count(*), sum(c_acctbal), min(c_phone), max(c_name)
  from customer join nation on c_nationkey = n_nationkey
  group by 1
  union all
  select null, null, 3, 1, count(*), sum(c_acctbal), min(c_phone), max(c_name)
  from customer join nation on c_nationkey = n_nationkey)
select count(*), sum(if(n = 2, 0, 1)) from (
  select count(*) n from (select * from r union all select * from u) t
  group by nn, seg, gid, gn, c, sb, mn, mx) v
