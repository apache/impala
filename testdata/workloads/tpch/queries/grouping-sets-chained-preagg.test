# Rollup over expressions.
with r as (
  select year(o_orderdate) y, month(o_orderdate) mo, o_orderpriority p,
    grouping_id() gid, count(*) c, sum(o_totalprice) sp, avg(o_totalprice) ap,
    max(o_comment) mx
  from orders
  group by rollup(year(o_orderdate), month(o_orderdate), o_orderpriority)),
u as (
  select year(o_orderdate) y, month(o_orderdate) mo, o_orderpriority p, 0 gid,
    count(*) c, sum(o_totalprice) sp, avg(o_totalprice) ap, max(o_comment) mx
  from orders group by 1, 2, 3
  union all
  select year(o_orderdate), month(o_orderdate), null, 1,
    count(*), sum(o_totalprice), avg(o_totalprice), max(o_comment)
  from orders group by 1, 2
  union all
  select year(o_orderdate), null, null, 3,
    count(*), sum(o_totalprice), avg(o_totalprice), max(o_comment)
  from orders group by 1
  union all
  select null, null, null, 7,
    count(*), sum(o_totalprice), avg(o_totalprice), max(o_comment)
  from orders)
select count(*), sum(if(n = 2, 0, 1)) from (
  select count(*) n from (select * from r union all select * from u) t
  group by y, mo, p, gid, c, sp, ap, mx) v
