---- QUERY
# Nested grouping sets that aren't a rollup.
with r as (
  select l_returnflag f, l_shipmode m, l_linestatus s, grouping_id() gid,
    count(*) c, sum(l_extendedprice) sp, max(l_comment) mx
  from lineitem
  group by grouping sets((l_returnflag, l_shipmode, l_linestatus),
    (l_returnflag, l_linestatus), (l_linestatus))),
u as (
  select l_returnflag f, l_shipmode m, l_linestatus s, 0 gid,
    count(*) c, sum(l_extendedprice) sp, max(l_comment) mx
  from lineitem group by 1, 2, 3
  union all
  select l_returnflag, null, l_linestatus, 2,
    count(*), sum(l_extendedprice), max(l_comment)
  from lineitem group by 1, 3
  union all
  select null, null, l_linestatus, 6,
    count(*), sum(l_extendedprice), max(l_comment)
  from lineitem group by 3)
select count(*), sum(if(n = 2, 0, 1)) from (
  select count(*) n from (select * from r union all select * from u) t
  group by f, m, s, gid, c, sp, mx) v
