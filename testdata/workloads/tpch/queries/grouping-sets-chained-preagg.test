---- QUERY
# CUBE and grouping sets that aren't nested can't be chained.
with r as (
  select l_returnflag f, l_linestatus s, grouping_id() gid, count(*) c,
    sum(l_extendedprice) sp, min(l_comment) mn
  from lineitem
  group by cube(l_returnflag, l_linestatus)),
u as (
  select l_returnflag f, l_linestatus s, 0 gid, count(*) c,
    sum(l_extendedprice) sp, min(l_comment) mn
  from lineitem group by 1, 2
  union all
  select l_returnflag, null, 1, count(*), sum(l_extendedprice), min(l_comment)
  from lineitem group by 1
  union all
  select null, l_linestatus, 2, count(*), sum(l_extendedprice), min(l_comment)
  from lineitem group by 2
  union all
  select null, null, 3, count(*), sum(l_extendedprice), min(l_comment)
  from lineitem)
select count(*), sum(if(n = 2, 0, 1)) from (
  select count(*) n from (select * from r union all select * from u) t
  group by f, s, gid, c, sp, mn) v
