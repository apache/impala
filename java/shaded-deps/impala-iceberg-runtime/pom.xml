<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                      http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>org.apache.impala</groupId>
    <artifactId>impala-parent</artifactId>
    <version>5.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <artifactId>impala-iceberg-runtime</artifactId>
  <packaging>jar</packaging>


  <properties>
    <iceberg.parquet.version>1.16.0</iceberg.parquet.version>
    <!-- Keep these runtime versions in sync with iceberg-core's POM when updating
         APACHE_ICEBERG_VERSION in bin/impala-config.sh. -->
    <iceberg.caffeine.version>2.9.3</iceberg.caffeine.version>
    <iceberg.roaringbitmap.version>1.6.14</iceberg.roaringbitmap.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-api</artifactId>
      <version>${iceberg.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-core</artifactId>
      <version>${iceberg.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-data</artifactId>
      <version>${iceberg.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-orc</artifactId>
      <version>${iceberg.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-parquet</artifactId>
      <version>${iceberg.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-hive-metastore</artifactId>
      <version>${iceberg.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.apache.parquet</groupId>
      <artifactId>parquet-avro</artifactId>
      <version>${iceberg.parquet.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.apache.parquet</groupId>
      <artifactId>parquet-column</artifactId>
      <version>${iceberg.parquet.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.apache.parquet</groupId>
      <artifactId>parquet-hadoop</artifactId>
      <version>${iceberg.parquet.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.apache.avro</groupId>
      <artifactId>avro</artifactId>
      <version>1.12.1</version>
      <optional>true</optional>
    </dependency>
    <!-- Runtime requirements of the bundled Iceberg classes. Keep these visible
         without exporting the bundled modules' optional provider dependencies. -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
      <version>${iceberg.caffeine.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.roaringbitmap</groupId>
      <artifactId>RoaringBitmap</artifactId>
      <version>${iceberg.roaringbitmap.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.airlift</groupId>
      <artifactId>aircompressor</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
      <version>${httpclient5.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.httpcomponents.core5</groupId>
      <artifactId>httpcore5</artifactId>
      <version>${httpcore5.version}</version>
    </dependency>
    <!-- Provided-scope dependencies needed to compile the patched HiveSchemaUtil
         which adds GEOMETRY/GEOGRAPHY support. Not included in the shaded jar.
         The Hive metastore API it also needs comes from a Hive version dependent
         artifact, see the hive-major-version-* profiles below. -->
    <dependency>
      <groupId>org.apache.impala</groupId>
      <artifactId>impala-minimal-hive-exec</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- FieldSchema implements org.apache.thrift.TBase, so javac needs libthrift on
         the classpath to read it. -->
    <dependency>
      <groupId>org.apache.thrift</groupId>
      <artifactId>libthrift</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <!-- The patched HiveSchemaUtil needs the Hive metastore API (FieldSchema), which
       lives in a different artifact for each Hive major version. Only the jar itself
       is needed to compile, so all transitive dependencies are excluded - Hive 2's
       hive-metastore otherwise pulls in jdk.tools (tools.jar), which does not exist
       in modern JDKs. These are not included in the shaded jar. -->
  <profiles>
    <profile>
      <id>hive-major-version-3</id>
      <activation>
        <property>
          <name>env.IMPALA_HIVE_MAJOR_VERSION</name>
          <value>3</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.apache.hive</groupId>
          <artifactId>hive-standalone-metastore</artifactId>
          <version>${hive.version}</version>
          <scope>provided</scope>
          <exclusions>
            <exclusion>
              <groupId>*</groupId>
              <artifactId>*</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
      </dependencies>
    </profile>

    <profile>
      <id>hive-major-version-2</id>
      <activation>
        <property>
          <name>env.IMPALA_HIVE_MAJOR_VERSION</name>
          <value>2</value>
        </property>
      </activation>
      <dependencies>
        <!-- Hive 2 has no standalone metastore, the API is in hive-metastore. -->
        <dependency>
          <groupId>org.apache.hive</groupId>
          <artifactId>hive-metastore</artifactId>
          <version>${hive.version}</version>
          <scope>provided</scope>
          <exclusions>
            <exclusion>
              <groupId>*</groupId>
              <artifactId>*</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
      </dependencies>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>true</createDependencyReducedPom>
              <artifactSet>
                <includes>
                  <include>org.apache.iceberg:*</include>
                  <include>org.apache.avro:*</include>
                  <include>org.apache.parquet:*</include>
                  </includes>
              </artifactSet>
              <relocations>
                <relocation>
                  <pattern>org.apache.avro</pattern>
                  <shadedPattern>impala.shaded.iceberg.avro</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.apache.parquet</pattern>
                  <shadedPattern>impala.shaded.iceberg.parquet</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>shaded.parquet</pattern>
                  <shadedPattern>impala.shaded.iceberg.parquet.shaded</shadedPattern>
                </relocation>
              </relocations>
              <filters>
                <!-- The project ships a patched copy of HiveSchemaUtil (adds
                     GEOMETRY/GEOGRAPHY support). Exclude Iceberg's own copy from the
                     shaded jar. -->
                <filter>
                  <artifact>org.apache.iceberg:iceberg-hive-metastore</artifact>
                  <excludes>
                    <exclude>org/apache/iceberg/hive/HiveSchemaUtil.class</exclude>
                    <exclude>org/apache/iceberg/hive/HiveSchemaUtil$*.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
