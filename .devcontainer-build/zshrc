setup-asf-gerrit-remote() {
  GIT_CFG_USER="$(git config user.name)"
  echo -n "Enter Github.com Username, press return to use default of '${GIT_CFG_USER}'> "
  read -r GIT_USER
  if [[ -z "${GIT_USER}" ]]; then
    GIT_USER="${GIT_CFG_USER}"
  fi

  pushd "${IMPALA_HOME}"
  git remote add asf-gerrit "ssh://${GIT_USER}@gerrit.cloudera.org:29418/Impala-ASF" 2>/dev/null
  git remote set-url asf-gerrit "ssh://${GIT_USER}@gerrit.cloudera.org:29418/Impala-ASF"
  echo
  echo "asf-gerrit remote:"
  git remote -v | grep asf-gerrit
  echo
  popd
  echo
  echo "Add this SSH public key to Gerrit: "
  cat "${HOME}/.ssh/id_ed25519.pub"
  echo
}

omake ()
{
  BASENAME="${1%.*}"
  BASENAME=${BASENAME##*/}
  MAKEFILE=$(grep -l "$BASENAME.cc.o:" $IMPALA_HOME/be/src/*/CMakeFiles/*.dir/build.make)
  MAKEFILE=${MAKEFILE#$IMPALA_HOME/}
  make DEBUG_NOOPT=1 -s -f $MAKEFILE ${MAKEFILE%/*}/$BASENAME.cc.o
}

mvn-debug-front-end() {
  local target_test=${1}
  if [[ -z ${target_test} ]]; then
    echo "Error: undefined target test"
  else
    mvn \
      -Dmaven.surefire.debug="-Xdebug \
      -Xrunjdwp:transport=dt_socket,server=y,suspend=y,address=8000 \
      -Xnoagent \
      -Djava.compiler=NONE" \
      -fae \
      -Dtest="${target_test}" \
      test
  fi
}

mvn-run-front-end() {
  local target_test=${1}
  if [[ -z ${target_test} ]]; then
    echo "Error: undefined target test"
  else
     mvn test -Dtest="${target_test}"
  fi
 }

resolve-minidump() {
  local log_dir="${1:-$IMPALA_LOGS_DIR/cluster}"
  local minidump_file

  if [[ "${log_dir}" == *".dmp" ]]; then
    minidump_file="${log_dir}"
  else
    minidump_file=$(grep "Wrote minidump to " "${log_dir}/impalad.ERROR" | rev | cut -d" " -f1 | rev)
  fi

  if [[ -z "${minidump_file}" ]]; then
    echo "Error: minidump file '${minidump_file}' not found"
    return 1
  fi

  echo "Resolving minidump: ${minidump_file}"
  resolve_minidumps.py --minidump_file "${minidump_file}" --output_file /tmp/resolve.txt
  cat /tmp/resolve.txt | head -n 100
}

setup-postgis() {
  local db_name="${1:-gisdb}"

  echo "Setting up PostGIS extension for PostgreSQL in the '${db_name}' database."
  sudo apt install -y postgresql-common gnupg2
  sudo /usr/share/postgresql-common/pgdg/apt.postgresql.org.sh -y
  POSTGRES_VER=$(sudo -u postgres psql -c "select version();" | grep "PostgreSQL" | sed -E 's/^\s*PostgreSQL\s*([0-9]+).*$/\1/')
  sudo apt install -y "postgresql-${POSTGRES_VER}-postgis-3"
  sudo apt install -y  postgis
  sudo -u postgres --preserve-env=db_name psql -c "CREATE DATABASE ${db_name};"
  sudo -u postgres --preserve-env=db_name psql -c "ALTER DATABASE ${db_name} OWNER TO hiveuser;"
  sudo -u postgres --preserve-env=db_name psql -d "${db_name}" -c "CREATE EXTENSION postgis;"
  sudo -u postgres --preserve-env=db_name psql -d "${db_name}" -c "SELECT postgis_full_version();"

  echo; echo "Adding connection to VSCode settings.json for database '${db_name}'."
  if [[ $(grep -c "localhost-${db_name}" "${IMPALA_HOME}/.vscode/settings.json") -gt 0 ]]; then
    echo "Connection localhost-${db_name} already exists; no change made."
  else
    awk -v db_name="${db_name}" '
      BEGIN { in_sqltools = 0; inserted = 0 }
      {
        if ($0 ~ /"sqltools.connections"[[:space:]]*:[[:space:]]*\[/) in_sqltools = 1

        if (in_sqltools && !inserted && $0 ~ /^[[:space:]]*\][[:space:]]*$/) {
          print "    ,"
          print "    {"
          print "      \"ssh\": \"Disabled\","
          print "      \"previewLimit\": 50,"
          print "      \"server\": \"localhost\","
          print "      \"port\": 5432,"
          print "      \"driver\": \"PostgreSQL\","
          print "      \"name\": \"localhost-" db_name "\",";
          print "      \"database\": \"" db_name "\",";
          print "      \"username\": \"hiveuser\","
          print "      \"password\": \"password\""
          print "    }"
          inserted = 1
          in_sqltools = 0
        }

        print
      }
    ' "${IMPALA_HOME}/.vscode/settings.json" > "${IMPALA_HOME}/.vscode/settings.json.tmp" && mv "${IMPALA_HOME}/.vscode/settings.json.tmp" "${IMPALA_HOME}/.vscode/settings.json"
  fi
}

