  echo -e "    * ${YELLOW}restart-hive${NC}: Starts or restarts Hive"
  echo -e "    * ${YELLOW}restart-minicluster${NC}: Starts or restarts all supporting services (HMS, HDFS, Kudu, etc)"
  echo -e "    * ${YELLOW}setup-postgis${NC}: Sets up PostGIS extension for PostgreSQL. Defaults to the 'gisdb' database. Can specify a different database name as the first argument."
